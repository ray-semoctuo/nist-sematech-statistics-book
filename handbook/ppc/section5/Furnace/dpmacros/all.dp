device 1 x11
device 1 font simplex
.
call data.dp
.
set ipl1na init.ps
device 2 postscript
pre-erase off
.
title size 3
label size 3
tic label size 3
char size 3 all
call init.dp
title size 
label size
tic label size
.
device 2 close
system mv INIT.PS init.ps
.
call percent.dp
.
call capabili.dp
