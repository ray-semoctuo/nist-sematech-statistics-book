.
.  Initialize
.
let p = 0.5
let nd = 4
let n = 20
.
let function fu = bincdf(4,p,20) - 0.05
let function fl = bincdf(3,p,20) - 0.95
.
let pu = roots fu wrt p  for p = .01 .99
let pl = roots fl wrt p  for p = .01 .99
.
let pu1 = pu(1)
let pl1 = pl(1)
let a1 = bincdf(4,pu1,20)
let a2 = bincdf(3,pl1,20)
.
capture binom.out
print "PU = ^pu1"
print "PL = ^pl1"
end of capture
