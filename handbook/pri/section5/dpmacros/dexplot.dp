. This is Dataplot program file    DEXPLOT.DP
. Purpose--Generate 10 plots essential to the analysis
.       of 2-level factorial designs
. Date--December 2000
.
. Modified to generate the plots for the BOXSPRIN.DAT data set.
. Assumptions:
.    1. Data is in Y
.    2. Factors are in X1, X2, X3, ...
.    3. Total number of factors is in K
.
. -----start point-----
.
device 1 x11
device 2 postscript
pre-erase off
dimension 100 variables
.
.  Following implement Jim Filliben's default settings
.
title displacement 2
tic offset units screen
tic offset 5 5
set write decimals 2
box shadow hw 0 0
title case asis
legend case asis
tic label case asis
character case asis all
tic label case asis
title size 4
label size 4
tic label size 4
.
. -----step 0: read in the data & get confounding structure-----
.
comment 2**3
skip 25; read BOXSPRIN.DAT Y X1 X2 X3
let k = 3
let string project = Metal Springs: % Acceptable (BB)
.
let kp1 = k+1
let kp2 = k+2
let n = number y
let index = 1 1 n
.
call confound.dp
.
. -----step 1: ordered data plot-----
.
device 1 off; device 2 off
ytic offset 0 0
plot y
probe fy1min; let mintic = probeval
probe fy1max; let maxtic = probeval
let rangetic = maxtic-mintic
ytic offset 5 5
device 1 on; device 2 on
.
loop for j = 1 1 k
   let z^j = x^j
end loop
if k = 1; let y2 = sortc y z1; end if
if k = 2; let y2 = sortc y z1 z2; end if
if k = 3; let y2 = sortc y z1 z2 z3; end if
if k = 4; let y2 = sortc y z1 z2 z3 z4; end if
if k = 5; let y2 = sortc y z1 z2 z3 z4 z5; end if
if k = 6; let y2 = sortc y z1 z2 z3 z4 z5 z6; end if
if k = 7; let y2 = sortc y z1 z2 z3 z4 z5 z6 z7; end if
if k = 8; let y2 = sortc y z1 z2 z3 z4 z5 z6 z7 z8; end if
if k = 9; let y2 = sortc y z1 z2 z3 z4 z5 z6 z7 z8 z9; end if
if k = 10; let y2 = sortc y z1 z2 z3 z4 z5 z6 z7 z8 z9 z10; end if
char x
lines blank
title Ordered Data Plot
y1label Response Y
x1label Settings
x1tics off
x1tic labels off
xmin -1
let yoffset = 2*k + 4
y1tic offset yoffset 5
plot y2 index
.
probe fy1min; let ybottom = probeval
probe fy1max; let ytop = probeval
let ybase = 20+yoffset-2
let yinc = 2
just center
loop for j = 1 1 k
   let ypos = ybase-j*yinc
   loop for l = 1 1 n
      let xpos = xplot(l)
      let zjl = z^j(l)
      let string ch = -
      if zjl = 1; let string ch = +; end if
      moveds xpos ypos
      text ^ch
   end loop
   move 20 ypos
   text X^j:
end loop
.
move 50 95; just center; hw 2 1; text ^project
call dexkn.dp
.
x1tics on
x1tic labels on
limits
y1tic offset 5 5
title
y1label
x1label
just left
device 2 close
system mv dppl1f.dat ordered.ps
erase
.
. -----step 2: dex scatter plot-----
.
device 2 postscript
. xtic offset 10 10
xtic offset 0 0
. xlimits 1 k
xlimits 0 kp1
. major x1tic number k
major x1tic number kp2
minor x1tic number 0
x1tic label format alphabetic
let string junk = sp() cr()
loop for j = 1 1 k
   let string junk = ^junk X^j
end loop
x1tic label contents ^junk
.
char x blank
lines blank dotted
title Scatter Plot
y1label Response Y
x1label Factors
dex scatter plot y x1 to x^k
.
limits freeze
pre-erase off
char bl all
lines solid all
plot yplot xplot xplot subset tagplot 1 to k
pre-erase on
limits
.
let dxplot = distinct xplot
let dxplot = sort dxplot
let ndxplot = number dxplot
let b = 18
just cece
loop for j = 1 1 ndxplot
   let a = dxplot(j)
   moveds a b
   let evenodd = mod(j,2)
   if evenodd = 1; text -; end if
   if evenodd = 0; text +; end if
end loop
.
move 50 95; just center; hw 2 1; text ^project
call dexkn.dp
.
limits
xtic offset 5 5
tic label format default
minor xtic number default
major xtic number default
just left
title
y1label
x1label
device 2 close
system mv dppl1f.dat  dexscat.ps
erase
pre-erase off
.
. -----step 3: dex mean plot-----
.
device 2 postscript
. xtic offset 10 10
xtic offset 0 0
. xlimits 1 k
xlimits 0 kp1
. major x1tic number k
major x1tic number kp2
minor x1tic number 0
x1tic label format alphabetic
let string junk = sp() cr()
loop for j = 1 1 k
   let string junk = ^junk X^j
end loop
x1tic label contents ^junk
.
char blank blank
lines solid dotted
char circle blank
char hw 1 1
char fill on off
title ^project cr() Main Effects Plot
title displacement 6
y1label Average Response
x1label Factors
dex mean plot y x1 to x^k
title displacement 2
save
.
let dxplot = distinct xplot
let dxplot = sort dxplot
let ndxplot = number dxplot
let b = 18
just cece
loop for j = 1 1 ndxplot
   let a = dxplot(j)
   moveds a b
   let evenodd = mod(j,2)
   if evenodd = 1; text -; end if
   if evenodd = 0; text +; end if
end loop
.
call dexkn.dp
.
limits
char blank all
char fill off
char hw 2 1
lines solid all
xtic offset 5 5
tic label format default
minor xtic number default
major xtic number default
just left
title
y1label
x1label
device 2 close
system mv dppl1f.dat dexmean.ps
erase
.
. -----step 4: interaction effects matrix-----
.
device 2 postscript
device 1 off; device 2 off
dex mean plot y x1 to x^k
device 1 on; device 2 on
.
let numfac = k
.
let ybar = mean y
let ybar2 = abs(ybar)
let lybar2 = log10(ybar2)
if lybar2 >= 0; let lybar3 = int(lybar2); end if
if lybar2 < 0; let lybar3 = -int(abs(lybar2))-1; end if
let dp = 3-lybar3
if dp < 0; let dp = 0; end if
.
let string stat = mean
.
. probe fy1min; let ybottom = probeval
. probe fy1max; let ytop = probeval
. let a = ybottom
. let b = ytop
. ylimits a b
ylimits freeze
.
let string s0 = Average Y
y1label displacement 15
loop for j = 1 1 k
   let string s^j = X^j
end loop
.
label size 10
tic label size 10
legend size 10
erase
device 2 close
device 2 postscript
call dexstat2.dp
move 50 96; just center; hw 4 2; text ^project
.
move 50 92
hw 4 2
justification center
text Interaction Effects Matrix
.
label size 4
tic label size 4
legend size
ylimits
y1label displacement default
title
y1label displacement
x1label
device 2 close
system mv dppl1f.dat interact.ps
erase
.
. -----step 5: block plot-----
.
device 2 postscript
char blank all
char - +
lines solid all
lines bl bl
x1tics off
x1tic labels off
.
char hw 4 3 4 3
legend 1 hw 4 3
tic label size 7
label size 7
.
y1label Average Response
y1label displacement 20
x1label Factor Combinations
.
multiplot corner coordinates 5 5 95 90
if k <= 12; multiplot 3 4; end if
if k <= 9; multiplot 3 3; end if
if k <= 6; multiplot 2 3; end if
if k <= 4; multiplot 2 2; end if
.
legend 1 coordinates 18 85
legend 1 x1
mean block plot y x2 x3 x1
legend 1 x2
mean block plot y x1 x3 x2
legend 1 x3
mean block plot y x1 x2 x3
multiplot off
.
move 50 96; just center; hw 4 2; text ^project
move 50 92; just center; hw 4 2; text Block Plots
.
legend 1
x1tics on
x1tic labels on
char hw 2 1 all
legend 1 hw 2 1
label size 4
tic label size 4
title
y1label
y1label displacement default
x1label
multiplot corner coordinates
device 2 close
system mv dppl1f.dat blockplt.ps
erase
.
. -----step 6: Youden plot-----
.
device 2 postscript
yates y
skip 0
read dpst1f.dat tag coef
.
device 1 off; device 2 off
dex mean plot y x1 to x^k
device 1 on; device 2 on
.
let numtag = number tag
loop for j = 1 1 numtag
   let posint = tag(j)
   call digit.dp
   let prod = ^sdigit
   let ymeanp(j) = mean y subset prod +1
   let ymeanm(j) = mean y subset prod -1
end loop
let effect = ymeanp - ymeanm
char blank all
. char automatic tag
lines blank all
probe fy1min; let ybottom = probeval
probe fy1max; let ytop = probeval
. let a = 50
. let b = 80
let ydel = ytop-ybottom
let a = ybottom + (1/14)*ydel; . 1/14 is correct for offset 5 5
let b = ytop - (1/14)*ydel
ylimits a b
xlimits a b
title displacement 6
title ^project cr() Youden Plot
y1label Average Response for Setting of +1
x1label Average Response for Setting of -1
let numeffec = number tag
let index2 = sequence 1 1 numeffec
plot ymeanp ymeanm index2
lines solid
draw data ybar a ybar b
draw data a ybar b ybar
.
hw 2 1
let numyplot = number yplot
just lece
loop for j = 1 1 numyplot
   let yplotj = yplot(j)
   movesd 86 yplotj
   let tagj = tag(j)
   let string ch = ^con^tagj:
.  text ^tagj
   text ^ch
   movesd 89 yplotj
   let string ch = ^cop^tagj
   text ^ch
end loop
move 86 90
text Factor: Confound
.
limits
title
y1label
x1label
.
loop for j = 1 1 numeffec
   let xpos = ymeanm(j)
   let ypos = ymeanp(j)
   let tagj = tag(j)
   let string ch = ^con^tagj
   movedata xpos ypos
   just cece
   text ^ch
end loop
.
call dexkn.dp
.
title displacement 2
limits
title
y1label
x1label
device 2 close
system mv dppl1f.dat youden.ps
erase
.
. -----step 7: |effects| plot-----
.
device 2 postscript
yates y
skip 0
read dpst1f.dat tag coef
.
title displacement 6
title ^project cr() |Effects| Plot
y1label |Effects|
x1label Factor
ygrid
x1tics off
x1tic label off
y1tic offset 10
char circle
char hw 1 1
char fill on
lines blank
spike on
let s = sd y
let coef2 = abs(coef)
plot coef2 index2
.
.
hw 2 1
if n > 20; hw 1.5 .75; end if
just cece
loop for j = 1 1 numeffec
   let x0 = xplot(j)
   let evenodd = mod(j,2)
   let y0 = 23
   if evenodd = 0; let y0 = 27; end if
   if n < 10; let y0 = 27; end if
   moveds x0 y0
   let tagj = tag(j)
   let string ch = ^con^tagj
.  text ^tagj
   text ^ch
end loop
.
let x0 = 57
let y0 = 86-2*numeffec-2
box fill on; box fill pattern solid; box fill color g80
box x0 y0 85 90
lines dotted
draw x0 87 85 87
.
hw 2 1
just left
let y0 = 88
let x0 = 60
move x0 y0
text Factor
let x0 = 70
move x0 y0
text Effect
let y0 = 86
loop for j = 1 1 numeffec
   let x0 = 60
   let y0 = y0-2
   move x0 y0
   let tagj = tag(j)
.  let string ch = ^con^tagj
   let string ch = ^cop^tagj
.  text ^tagj
   text ^ch
.  let x0 = 70
   let x0 = 74
   move x0 y0
   let coefj = coef(j)
   text : ^coefj
end loop
.
let x0 = 35
let y0 = 87
box 15 90 x0 y0
let y0 = 88
let x0 = 17
move x0 y0
let ybar = average y
text Average = ^ybar
.
let numyplot = number yplot
just lece
loop for j = 1 1 numyplot
   let yplotj = yplot(j)
   movesd 86 yplotj
   let tagj = tag(j)
   let string ch = ^con^tagj:
.  text ^tagj
   text ^ch
   movesd 89 yplotj
   let string ch = ^cop^tagj
   text ^ch
end loop
move 86 90
text Factor:cr()Unconfounded
.
box fill off; box fill pattern off; box fill color g80
grid off
y1tic offset 5
x1tics on
x1tic label on
char blank all
char hw 2 1
lines solid all
spike off
just left
title
title displacement 2
y1label
x1label
tic offset 5 5
device 2 close
system mv dppl1f.dat effects.ps
erase
.
. -----step 8: halfnormal probability plot-----
.
label size 4
tic label size 4
device 2 postscript
yates y
skip 0
read dpst1f.dat tag coef
.
let coef2 = abs(coef)
char x
lines bl
title displacement 6
title ^project cr() Half-normal Probability Plot of Effects
y1label Ordered |Effects|
x1label Half-normal Distribution Order Statistic Medians
halfnormal probability plot coef2
.
let numyplot = number yplot
just lece
loop for j = 1 1 numyplot
   let yplotj = yplot(j)
   movesd 86 yplotj
   let jrev = numyplot-j+1
   let tagjrev = tag(jrev)
   let string ch = ^con^tagjrev:
.  text ^tagjrev
   text ^ch
   movesd 89 yplotj
   let string ch = ^cop^tagjrev
   text ^ch
end loop
move 86 90
text Factor: Conf.
.
call dexkn.dp
.
just left
title
title displacement 2
y1label
x1label
device 2 close
system mv dppl1f.dat halfnorm.ps
erase
.
. -----step 9: cumulative residual sd plot-----
.
yates y
skip 0
read dpst1f.dat tag coef tcoef indrsd cumrsd
.
title displacement 6
device 2 postscript
title ^project cr()Cumulative Residual SD Plot
y1label Residual SD
x1label Cumulative Model
ygrid
x1tics off
x1tic label off
y1tic offset 10
char circle
char hw 1 1
char fill on
lines blank
spike on
let numeffec = number tag
let numeffp1 = numeffec+1
let index2 = sequence 1 1 numeffec
let s = sd y
let cumrsd(numeffp1) = s
let index2(numeffp1) = 0
plot cumrsd index2
.
hw 2 1
if n > 20; hw 1.5 .75; end if
just cece
loop for j = 1 1 numeffec
   let x0 = xplot(j)
   let evenodd = mod(j,2)
   let y0 = 23
   if evenodd = 0; let y0 = 27; end if
   if n < 10; let y0 = 27; end if
   moveds x0 y0
   let tagj = tag(j)
   let string ch = ^con^tagj
.  text ^tagj
   text ^ch
end loop
moveds 0 27
if n <= 20; text Average; end if
if n > 20; text Ave.; end if
.
let numyplot = number yplot
let numyplm1 = numyplot-1
just lece
loop for j = 1 1 numyplm1
   let yplotj = yplot(j)
   movesd 86 yplotj
   let tagj = tag(j)
   let string ch = ^con^tagj:
.  text ^tagj
   text ^ch
   movesd 89 yplotj
   let string ch = ^cop^tagj
   text ^ch
end loop
move 86 90
text Factor: Confound
.
call dexkn.dp
.
grid off
y1tic offset 5
x1tics on
x1tic label on
char blank all
char hw 2 1
lines solid all
spike off
just left
title displacement 2
title
y1label
x1label
tic offset 5 5
hw 2 1
device 2 close
system mv dppl1f.dat cumressd.ps
erase
.
 . -----step 10: contour plot-----
 .
thickness 0.15
title displacement 6
title size 4
label size 4
tic label size 4
device 2 postscript
device 1 off; device 2 off
tic offset 0 0
plot y
probe fy1min; let mintic = probeval
probe fy1max; let maxtic = probeval
let rangetic = maxtic-mintic
let sigdig = msd(rangetic)
let inc = rangetic/sigdig
let numinc = rangetic/inc
let inc2 = inc
if numinc = 1; let inc2 = inc/10; end if
if numinc = 2; let inc2 = inc/5; end if
if numinc = 3; let inc2 = inc/3; end if
if numinc = 4; let inc2 = inc/2; end if
if numinc = 5; let inc2 = inc/2; end if
if numinc = 6; let inc2 = inc/2; end if
device 1 on; device 2 on
.
yates y
skip 0
read dpst1f.dat tag coef
.
. let posint = tag(1)
let tagj = tag(1)
let posint = ^con^tagj
call digit.dp
let numdig1 = numdig
let d1 = digit(1)
if numdig1 >= 2; let d2 = digit(2); end if
.
. let posint = tag(2)
let tagj = tag(2)
let posint = ^con^tagj
call digit.dp
let numdig2 = numdig
let d3 = digit(1)
if numdig2 >= 2; let d4 = digit(2); end if
.
print numdig1 d1 d2 numdig2 d3 d4
if numdig1 >= 2
   let u1 = x^d1; let hit1 = d1
   let u2 = x^d2; let hit2 = d2
end if
.
if numdig1 = 1
   let u1 = x^d1; let hit1 = d1
   let u2 = x^d3; let hit2 = d3
   if numdig2 >= 2
      if d3 = d1; let u2 = x^d4; let hit2 = d4; end if
      if d4 = d1; let u2 = x^d3; let hit2 = d3; end if
   end if
end if
.
let start = mintic - 3*inc2
let stop = maxtic + 3*inc2
let ycont = sequence start inc2 stop
title: ^project cr()Contour Plot of the 2 Dominant Factors: X^hit1 and X^hit2
y1label X^hit1
x1label X^hit2
erase
. call dexcont.dp
.
line solid all
line blank dotted
line thickness 0.1 0.1 0.3 0.1 0.1 0.3
character zval circle
character fill off on
.
dex contour plot y u1 u2 ycont
system mv dppl1f.dat contour.ps
.
quit
