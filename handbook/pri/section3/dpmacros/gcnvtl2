iflist=$*

for file in $iflist
do
rfn=`ls $file | cut -d\. -f 1`
echo ${rfn}
ex - $file << end-of-edit
g/BoundingBox:.*/s//BoundingBox: 0 0 612 792/g
wq
end-of-edit
ex - ${rfn}.r.tex << end-of-edit
a
\documentclass{article}
\oddsidemargin-1.22in
\evensidemargin-1.22in
\textwidth8.5in
\topmargin4.1in
\textheight11in
\pagestyle{empty}
\topskip0in
\headheight0in
\headsep0in
\marginparsep0in
\marginparwidth0in
\paperheight11in
\paperwidth8.5in
\usepackage{epsfig}
\begin{document}
\epsfig{file=$file,width=348pt,height=450pt,angle=-90}
\end{document}
.
wq
end-of-edit
latex ${rfn}.r.tex
dvips -t letter -o ${rfn}.r.ps  ${rfn}.r.dvi
ex - ${rfn}.r.ps << end-of-edit
g/^%%BoundingBox:.*\$/s//%%BoundingBox: 0 0 450 348/g
wq
end-of-edit
done

gflist=`ls *.r.ps`
echo $gflist

dir=`pwd`
ls $gflist > temp1
ls $iflist > temp2
ls $gflist > temp3
ls $iflist > temp4
ls $gflist > temp5
chmod 755 temp*

ex - temp1 << end-of-edit
g?\(.*\)?s??convert $dir/\1 $dir/\1?g
g/ps\$/s//gif/g
wq
end-of-edit

rsh visage $dir/temp1

ex - temp2 << end-of-edit
g?\(.*\)?s??convert -rotate 90 $dir/\1 $dir/\1?g
g/\.ps\$/s//\.gif/g
wq
end-of-edit

rsh visage $dir/temp2

ex - temp3 << end-of-edit
g?\(.*\)?s??shrink $dir/\1?g
g/\.ps\$/s//\.gif/g
wq
end-of-edit

temp3

ex - temp4 << end-of-edit
g?\(.*\)?s??shrink $dir/\1?g
g/\.ps\$/s//\.gif/g
wq
end-of-edit

temp4

ex - temp5 << end-of-edit
g?\(.*\)?s??stb $dir/\1?g
g/\.ps\$/s//\.gif/g
wq
end-of-edit

temp5

rm temp[12345] *.r.tex *.r.aux *.r.log *.r.dvi *.r.ps
