.
.  Macro to generate plot of residuals versus time
.
device 1 x11
device 2 postscript
.
thickness 0.15
tic mark label size 3
label case asis
label size 3
x3label size 4
x3label Figure 2.4
.
. let y = norm rand numb for i = 1 1 30
serial read y
0.8 1.7 0.2 0.4 -0.6 0.3 0.8 -0.4 2.7 1.8 0.8 -0.2
0.9 -1.1 -0.1 -2.9 -0.1 0.1 0.3 -1.4 0 0.3 -1.9 0.1 -0.5
0.2 0.1 -1.6 -1.4 -0.1 -1.5 -0.2
end of data
.
xlimits 0 30
xtic offset 0 4
label case asis
x1label Sequence Number
y1label Residuals
char +
line blank
plot y
limits freeze
pre-erase off
.
let xtemp = xplot
let ytemp = yplot
lowess fraction 0.6
lowess ytemp xtemp
.
line dashed
char blank
plot pred xtemp
line dotted
let n = size xtemp
let ytemp = 0 for i = 1 1 n
plot ytemp xtemp
.
device 2 close
.
system cp dppl1f.dat restime1.ps
.
