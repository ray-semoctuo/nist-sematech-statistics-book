device 1 close
pre-erase off
label case asis
set postscript ppi 800
frame coordinates 10 10 99 99 
char size 1
label size 3
tic mark label size 3
char fill on
char circle 
lines blank
device 2 postscript
skip 1
read pr1.dat time tmp yt y
xlabel Time, minutes
y1label Torque
xlimits 0 120
ylimits 5 8
tic offset units data
xtic offset 2.7 2.7
ytic offset 0.15 0.15
let b1 = 5
let b2 = 3
let b3 = 50
let b4 = 1.2
fit y = b1 + b2*exp(-(time/b3)**b4)
plot y pred vs time
device 2 close
system mv dppl1f.dat mvpr1.ps
quit
