device 1 close
pre-erase off
label case asis
set postscript ppi 800
frame coordinates 10 10 99 99 
char size 1
label size 3
tic mark label size 3
char fill on
char circle 
lines blank
device 2 postscript
seed 68
let x = uniform random numbers for i = 1 1 40
let x = 20 + 50*x
let yt = 5 + 4*x
seed 9
let z = normal random numbers for i = 1 1 40
let z = 5*z
let y = yt + z
let day = sequence 1 10 1 4 
linear fit y x
set write decimals 3
xlabel Day
y1label Residuals from Straight Line Model
xlimits 1 4
ylimits -10 10
tic offset units data
xtic offset 0.3 0.3
ytic offset 1 1
plot res day
lines dash
draw data 0.7 0 4.3 0
device 2 close
system mv dppl1f.dat mvpt3.ps
quit
