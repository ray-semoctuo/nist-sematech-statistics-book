device 1 close
pre-erase off
label case asis
set postscript ppi 800
frame coordinates 10 10 99 99 
char size 1
label size 3
tic mark label size 3
char fill on
char circle 
lines blank
device 2 postscript
delete pred
skip 1
read tc1.dat x yt y pred
let res = y-pred
xlabel Temperature
y1label Residuals from LOESS Model
xlimits 100 600
ylimits -0.1 0.1
tic offset units data
xtic offset 10 10
ytic offset 0.01 0.01 
plot res x
lines dash
draw data 90 0 610 0
device 2 close
system mv dppl1f.dat mvtc1.ps
quit
