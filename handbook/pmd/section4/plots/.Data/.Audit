if(search()[1]!="prex1.dat") attach(prex1.dat,pos=1)
utmp <- unique(tmp)
l.utmp <- length(utmp)
m1 <- 1:l.utmp
tau <- 1:l.utmp
beta <- 1:l.utmp
m0 <- 1:l.utmp
tf <- seq(0,120,length=100)
postscript(file="msprex3.ps",hor=F)
par(mfrow=c(3,2))
for(i in 1:l.utmp)
{
itmp <- tmp==utmp[i];nlf <- nls(y[itmp]~m1*exp(-(t[itmp]/tau)^beta)+m0,
           start=list(m1=3,tau=3+0.01*utmp[i]+0.015*utmp[i]^2,beta=1.2,m0=5));plot(t[tmp==utmp[i]],y[tmp==utmp[i]],ylimits=c(5,8),xlab="Time, minutes",ylab="Torque");m1 <- nlf$par[1];tau <- nlf$par[2];beta <- nlf$par[3];m0 <- nlf$par[4];pred <- m1*exp(-(tf/tau)^beta)+m0,
#~error: statement with syntax error
