source("r11p.s")
postscript(file="r11p1.ps",hor=T)
par(pty="s",mfrow=c(1,2),mgp=c(2.5,0.75,0))
p1 <- 1
p2 <- 2
p3 <- 3
p <- c(p1,p2,p3)

offset <- 0.05
x1 <- seq(-1.5,-1/p3-offset,length=100)
x2 <- seq(-1/p3+offset,1.5,length=100)

plot(c(x1,x2),c(r11(x1,p),r11(x2,p)),type="n",ylab="y",xlab="x")
lines(x1,r11(x1,p))
lines(x2,r11(x2,p))
abline(h=p2/p3,lty=2)
abline(v=-1/p3,lty=2)

p1 <- -1
p2 <- 2
p3 <- 3
p <- c(p1,p2,p3)

offset <- 0.05
x1 <- seq(-1.5,-1/p3-offset,length=100)
x2 <- seq(-1/p3+offset,1.5,length=100)

plot(c(x1,x2),c(r11(x1,p),r11(x2,p)),type="n",ylab="y",xlab="x")
lines(x1,r11(x1,p))
lines(x2,r11(x2,p))
abline(h=p2/p3,lty=2)
abline(v=-1/p3,lty=2)
dev.off()

