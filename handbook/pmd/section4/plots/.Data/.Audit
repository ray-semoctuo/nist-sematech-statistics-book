par(mfrow=c(3,3),oma=c(0,0,0,0),mar=c(4,4,2,3),mgp=c(1.75,0.75,0))
x1g <- seq(0,90,length=20)
x2g <- seq(0,90,length=20)
persp.setup(lwd=c(0,0,0))
pp <- persp(x1g,x2g,matrix(40,nrow=length(x1g),ncol=length(x2g)),
            xlab="x1",
            ylab="x2",
            zlab="y",
            zlim=c(20,60))
x1 <- runif(50,min=0,max=90)
x2 <- runif(50,min=0,max=90)
yt <- 40 + 0.025*x1 - 0.035*x2 + 0.001*x1^2 - 0.001*x2^2
y <- yt + rnorm(length(yt),sd=1)
