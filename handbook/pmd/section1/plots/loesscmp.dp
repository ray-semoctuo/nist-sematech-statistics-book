device 1 close
pre-erase off
label case asis
set postscript ppi 800
frame coordinates 10 10 99 99 
char size 1
label size 3
tic mark label size 3
char fill on
char circle 
y1label offset 15
lines blank
device 2 postscript
skip 1
read loesscmp.dat x y
read loesscmpp.dat xp lrf
xlabel x
y1label y
ylimits 0 275
tic offset units data
xtic offset 0.5 0.5
ytic offset 10 10 
plot y x and
plot lrf xp
device 2 close
system mv dppl1f.dat loesscmp.ps
quit
