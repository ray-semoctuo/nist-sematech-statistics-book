device 1 close
pre-erase off
tic offset units absolute
tic offset 2 2
label case asis
set postscript ppi 800
char size 12
char .
lines blank
label size 8
tic mark label size 8
device 2 postscript
seed 73 
let x = uniform random numbers for i = 1 1 40
let x = 20 + 50*x
let xf = sequence 20 0.1 70
let yt = 900 - x - 0.15*x**2 + 50*sin(x/2)
seed 50
let z = normal random numbers for i = 1 1 40
let z = 2*z
let y = yt + z
let a0=900
let a1= -1
let a2= -0.15
let a3= 50
let a4= 2
fit y = a0 + a1*x + a2*x**2 + a3*sin(x/a4)
let predf = a0 + a1*xf + a2*xf**2 + a3*sin(xf/a4)
multiplot corner coordinates 5 5 95 95
multiplot 3 3
label case lower
xlabel x
xlabel displacement 15
y1label y
y1label displacement 15 
major ytic mark number 4
plot y x
xlabel 
ylabel 
lines solid
char blank
plot predf xf
char . 
lines blank
ylimits -7 7 
major ytic mark number 5
plot z x
ylimits
major ytic mark number 4
multiplot 3 3 2 2
char blank
lines solid
plot predf xf
bar fill on
bar width 0.4
xlimits -7 7 
ylimits 0 0.3
major xtic mark number 5
relative histogram z
xlimits
ylimits
major xtic mark number
multiplot 3 3 3 2
plot predf xf
 xlimits -7 7
 ylimits 0 0.3
 major xtic mark number 5
 let zn = sequence -6 0.1 6
 let p = (1/(2*sqrt(2*pi)))*exp(-0.5*(zn/2)**2)
 char blank
 lines solid 
 plot p vs zn 
 xlimits
 ylimits
 major xtic mark number 
multiplot off
move 33 80; text = 
move 33 50; text = 
move 33 20; text = 
move 63 80; text + 
move 63 50; text + 
move 63 20; text +
device 2 close
system mv dppl1f.dat gipm2.ps
quit
