#~put ".Data/.Last.value" 885843777 ...
#~
help(par)
#~put ".Data/.Last.value" 885843805 ...
#~
source("gipm3.s")
#postscript("gipm3.ps",hor=F)
par(mfrow=c(3,3),oma=c(0,0,0,0),mar=c(4,4,2,3),mgp=c(1.75,0.75,0))
x1g <- seq(0,90,length=20)
x2g <- seq(0,90,length=20)
x1 <- runif(50,min=0,max=90)
x2 <- runif(50,min=0,max=90)
yt <- 43 + 0.125*x1 - 0.035*x2 - 0.001*x1^2 - 0.001*x2^2
y <- yt + rnorm(length(yt),sd=0.25)
lf <- lm(y~cbind(x1,x2,x1*x2,x1^2,x2^2))
rpf <- function(x1,x2) lf$coef[1] + lf$coef[2]*x1 + lf$coef[3]*x2 +
                       lf$coef[4]*x1*x2 + lf$coef[5]*x1^2 + lf$coef[6]*x2^2

persp.setup(lwd=c(0,0,0))
pp <- persp(x1g,x2g,matrix(40,nrow=length(x1g),ncol=length(x2g)),
            xlab="x1",
            ylab="x2",
            zlab="y",
            zlim=c(30,50))
points(perspp(x1,x2,y,pp))

persp.setup(lwd=c(1,1,1))
persp(x1g,x2g,outer(x1g,x2g,rpf),
      xlab="x1",
      ylab="x2",
      zlab="y",
      zlim=c(30,50))

persp.setup(lwd=c(0,0,0))
pp <- persp(x1g,x2g,matrix(0,nrow=length(x1g),ncol=length(x2g)),
            xlab="x1",
            ylab="x2",
            zlab="y",
            zlim=c(-1,1))
points(perspp(x1,x2,lf$res,pp))

par(mfg=c(2,2,3,3))
persp.setup(lwd=c(1,1,1))
persp(x1g,x2g,outer(x1g,x2g,rpf),
      xlab="x1",
      ylab="x2",
      zlab="y",
      zlim=c(30,50))

hist(lf$res)

par(mfg=c(3,2,3,3))
persp.setup(lwd=c(1,1,1))
persp(x1g,x2g,outer(x1g,x2g,rpf),
      xlab="x1",
      ylab="x2",
      zlab="y",
      zlim=c(30,50))

plot(seq(-1,1,0.01),ncdf(seq(-1,1,0.01))

#dev.off()

