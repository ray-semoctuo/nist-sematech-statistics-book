let p2 = 2.5
let p3 = 1
let p4 = -2
let p5 = 2
let p6 = 4
let p7 = 0.3
title y = (-1.5+2.5x+x^2-2x^3)/(1 + 2x + 4x^2 + 0.3x^3)
.
