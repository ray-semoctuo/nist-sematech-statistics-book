dimension 20 variables
.
device 1 x11
set ipl1na shape6.ps
device 2 postscript
.
. let function fnum = (1.079-0.122*x+0.004097*x**2-0.00000143*x**3)
. let function fden = (1-0.00576*x+0.000241*x**2-0.000000123*x**3)
let a0 = 1.07913
let a1 = -0.122801
let a2 = 0.00408837
let a3 = -0.00000142848
let b1 = -0.00576111
let b2 = 0.000240629
let b3 = -0.000000123254
let function fnum = (a0 + a1*x + a2*x**2 + a3*x**3)
let function fden = (1 + b1*x + b2*x**2 + b3*x**3)
let function f = fnum/fden
.
window corner coordiantes 0 0 50 50
tic marks off
tic mark labels off
y2frame off
x2frame off
xlabel x
y1label y
ylimits -5 25
xlimits 0 800
label size 6
tic label size 6
plot f for x = 20 .1 800
line dash
. let yval = a3/b3
let yval = 22
drawdata 0 yval 800 yval
let yval = yval - 1
movedata -40 yval
height 6
text c
line solid all
limits
.
window corner coordiantes 50 0 100 50
pre-erase off
tic offset 0 0.2
x1tic mark labels on
y1tic mark labels on
xlabel m
y1label n
label size 6
character size 12
grid on
grid pattern solid
limits 0 5
major tic mark number 6
minor tic mark number 0
lines dash blank dash dash
lines thickness 0.1 0.1 0.1 0.3
character blank circle blank blank
character fill on all
let y1 = data 0 5
let x1 = y1
let y2 = data 1 2 3 4 5
let x2 = y2
let y3 = data 1 0
let x3 = data 0 1
let y4 = data 1 1
let x4 = data 0 5
plot y1 vs x1 and
plot y2 vs x2 and
plot y3 vs x3 and
plot y4 vs x4
.
window corner coordinates 0 50 100 100
justification left
height 6
move 25 80
text Question 1: C   n = m
move 25 70
text Question 2: 0   n <= m
move 25 60
text Question 3: 1   n >= 1
move 25 50
text Question 4: 0   n >= 1 - m
move 25 40
text Simplest Case: n = 1, m = 1
move 30 33
text (linear/linear) and (quadratic/quadratic)
.
device 2 close
system mv SHAPE6.PS shape6.ps
.
