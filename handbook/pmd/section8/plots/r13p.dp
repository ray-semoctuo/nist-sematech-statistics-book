  let atemp2 = r(2)
  let atemp3 = r(3)
  let a1 = atemp1 - 0.1
  let a2 = atemp1 + 0.1
  let a3 = atemp2 - 0.1
  let a4 = atemp2 + 0.1
  let a5 = atemp3 - 0.1
  let a6 = atemp3 + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 a3 and
  plot f for x = a4 0.01 a5 and
  plot f for x = a6 0.01 axmax
  line dash
  drawdata atemp1 aymin atemp1 aymax
  drawdata atemp2 aymin atemp2 aymax
  drawdata atemp3 aymin atemp3 aymax
end of if
.
drawdata axmin 0 axmax 0
line solid
ylimits
xlimits
delete r
.
end of multiplot
title size
.
device 2 close
system cp dppl1f.dat r13p1.ps
.
erase
device 2 postscript
.
let p1 = 3
let p2 = 0.5
let p3 = 5
let p4 = -0.5
let p5 = 2
