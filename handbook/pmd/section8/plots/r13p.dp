device 1 x11
substitute character @
.
let function fnum = P1 + P2*x
let function fden = 1 + P3*x + P4*x**2 + P5*x**3
let function f = (fnum)/(fden)
.
xlabel x
y1label y
x1label displacement 11
y1label displacement 10
multiplot scale factor 2.5
title size 2.3
.
pre-erase off
erase
device 2 postscript
.
multiplot 2 2
multiplot corner coordinates 2 2 98 98
.
let p1 = 1
let p2 = 2
let p3 = 1
let p4 = 3
let p5 = 1
title y = (1+2x)/(1 + x + 3x^2 + x^3)
.
let aymin = -5
let aymax = 5
let axmin = -5
let axmax = 5
ylimits aymin aymax
.
let nr = 0
let r = roots fden wrt x for x = axmin to axmax
let nr = size r
.
echo on
.
if nr = 0
  plot f for x = axmin 0.01 axmax
  line dash
end of if
if nr = 1
  let atemp = r(1)
  let a1 = atemp - 0.05
  let a2 = atemp + 0.05
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 axmax
  line dash
  drawdata atemp aymin atemp aymax
end of if
if nr = 2
  let atemp1 = r(1)
  let atemp2 = r(2)
  let a1 = atemp1 - 0.1
  let a2 = atemp1 + 0.1
  let a3 = atemp2 - 0.1
  let a4 = atemp2 + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 a3 and
  plot f for x = a4 0.01 axmax
  line dash
  drawdata atemp1 aymin atemp1 aymax
  drawdata atemp2 aymin atemp2 aymax
end of if
if nr = 3
  let atemp1 = r(1)
  let atemp2 = r(2)
  let atemp3 = r(3)
  let a1 = atemp1 - 0.1
  let a2 = atemp1 + 0.1
  let a3 = atemp2 - 0.1
  let a4 = atemp2 + 0.1
  let a5 = atemp3 - 0.1
  let a6 = atemp3 + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 a3 and
  plot f for x = a4 0.01 a5 and
  plot f for x = a6 0.01 axmax
  line dash
  drawdata atemp1 aymin atemp1 aymax
  drawdata atemp2 aymin atemp2 aymax
  drawdata atemp3 aymin atemp3 aymax
end of if
.
drawdata axmin 0 axmax 0
line solid
ylimits
delete r
.
let p1 = 1
let p2 = 2
let p3 = 1
let p4 = -3
let p5 = 0.3
title y = (1+2x)/(1 + x - 3x^2 + 0.3x^3)
.
let aymin = -10
let aymax = 10
let axmin = -10
let axmax = 15
ylimits aymin aymax
.
let nr = 0
let r = roots fden wrt x for x = axmin to axmax
let nr = size r
.
if nr = 0
  plot f for x = axmin 0.1 axmax
  line dash
end of if
if nr = 1
  let atemp = r(1)
  let a1 = atemp - 0.1
  let a2 = atemp + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 axmax
  line dash
  drawdata atemp aymin atemp aymax
end of if
if nr = 2
  let atemp1 = r(1)
  let atemp2 = r(2)
  let a1 = atemp1 - 0.1
  let a2 = atemp1 + 0.1
  let a3 = atemp2 - 0.1
  let a4 = atemp2 + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 a3 and
  plot f for x = a4 0.01 axmax
  line dash
  drawdata atemp1 aymin atemp1 aymax
  drawdata atemp2 aymin atemp2 aymax
end of if
if nr = 3
  let atemp1 = r(1)
  let atemp2 = r(2)
  let atemp3 = r(3)
  let a1 = atemp1 - 0.1
  let a2 = atemp1 + 0.1
  let a3 = atemp2 - 0.1
  let a4 = atemp2 + 0.1
  let a5 = atemp3 - 0.1
  let a6 = atemp3 + 0.1
  plot f for x = axmin 0.01 a1 and
  plot f for x = a2 0.01 a3 and
  plot f for x = a4 0.01 a5 and
  plot f for x = a6 0.01 axmax
  line dash
  drawdata atemp1 aymin atemp1 aymax
  drawdata atemp2 aymin atemp2 aymax
  drawdata atemp3 aymin atemp3 aymax
end of if
.
drawdata axmin 0 axmax 0
line solid
ylimits
delete r
.
let p1 = 1
let p2 = 2
let p3 = 1
let p4 = -3
let p5 = -1
title y = (1+2x)/(1 + x - 3x^2 - x^3)
.
let aymin = -5
let aymax = 5
let axmin = -5
let axmax = 5
ylimits aymin aymax
.
let nr = 0
let r = roots fden wrt x for x = axmin to axmax
let nr = size r
.
if nr = 0
  plot f for x = axmin 0.1 axmax
  line dash
end of if
if nr = 1
  let atemp = r(1)
  let a1 = atemp - 0.1
  let a2 = atemp + 0.1
