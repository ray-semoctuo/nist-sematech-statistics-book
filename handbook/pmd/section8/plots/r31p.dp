device 1 x11
substitute character @
.
let function fnum = P1 + P2*x + P3*x**2 + P4*x**3
let function fden = 1 + P5*x
let function f = (fnum)/(fden)
.
xlabel x
y1label y
x1label displacement 11
y1label displacement 10
multiplot scale factor 2.5
title size 2.2
.
device 2 postscript
.
multiplot 2 2
multiplot corner coordinates 2 2 98 98
.
let p1 = 1
let p2 = -5/6
let p3 = -1/3
let p4 = 1/6
let p5 = 2
title y = (1 - (5/6)x - (1/3)x^2 + (1/6)x^3)/(1+2x)
let axmin = -10
let axmax = 10
ylimits -10  10
.
plot f for x = axmin 0.1 -0.6 and
plot f for x = -0.4 0.1 axmax
line dash
drawdata -0.5 -10 -0.5 10
line solid
ylimits
.
let p1 = 1
let p2 = 2
let p3 = 3
let p4 = 1
let p5 = 0.5
title y = (1 + 2x + 3x^2 + x^3)/(1 + 0.5x)
let axmin = -10
let axmax = 10
ylimits -100 200
.
plot f for x = axmin 0.01 -2.05 and
plot f for x = -1.95 0.01 axmax
line dash
drawdata -2 -100 -2 200
line solid
.
ylimits -500 500
.
let p1 = 1
let p2 = -2
let p3 = 3
let p4 = -1
let p5 = 0.5
title y = (1 - 2x + 3x^2 - x^3)/(1 + 0.5x)
.
plot f for x = axmin 0.1 -2.1 and
plot f for x = -1.9 0.1 axmax
line dash 
drawdata -2 -500 -2 500
line solid
ylimits
.
end of multiplot
title size
.
device 2 close
system cp dppl1f.dat r31p1.ps
stop
.
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = -1
title y = (4 + 2x + 7x^2 - 2x^3)/(1 - x)
plot f for x = 1.1 .1 10
.
device 2 close
system cp dppl1f.dat r31p2.ps
.
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = -1
title y = (4 + 2x + 7x^2 - 2x^3)/(1 - x)
.
xlimits -10 0
xtic offset 0 1
ylimits 0 250
.
plot f for x = -10 0.1 0.9
.
xlimits
xtic offset 0 0
ylimits
.
device 2 close
system cp dppl1f.dat r31p3.ps
.
device 2 postscript
.
let p1 = 4
let p2 = -2
let p3 = -7
let p4 = 2
let p5 = -1
title y = (4 - 2x - 7x^2 + 2x^3)/(1 - x)
.
ylimits -150  50
.
plot f for x = 1.1 .1 10
.
ylimits -150 -50
.
pause
.
device 2 close
system cp dppl1f.dat r31p4.ps
.
device 2 postscript
.
let p1 = 4
let p2 = -2
let p3 = -7
let p4 = 2
let p5 = -1
title y = (4 - 2x - 7x^2 + 2x^3)/(1 - x)
.
xlimits -10 0
xtic offset 0 1
ylimits -250 50
.
plot f for x = -10 0.01 0.98
.
xlimits
xtic offset 0 0
ylimits
.
device 2 close
system cp dppl1f.dat r31p5.ps
.
