dimension 20 variables
.
device 1 x11
set ipl1na shape4.ps
device 2 postscript
.
let function fnum = 1 + x
let function fden = 1 + 0.5*x
let function f = (fnum)/(fden)
.
window corner coordiantes 0 0 50 50
tic marks off
tic mark labels off
y2frame off
x2frame off
xlabel x
y1label y
ylimits 0 2
xlimits -2 10
ytic offset 0 0.2
label size 6
tic label size 6
plot f for x = -1.99 0.01 10
line dash
let yval = 2
drawdata -2 yval 10 yval
let yval = yval - .02
movedata -2.7 yval
height 6
text c
line solid all
limits
.
window corner coordiantes 50 0 100 50
pre-erase off
tic offset 0 0.2
x1tic mark labels on
y1tic mark labels on
xlabel m
y1label n
label size 6
character size 12
grid on
grid pattern solid
limits 0 5
major tic mark number 6
minor tic mark number 0
lines dash blank dash
character blank circle blank
character fill on all
let y1 = data 0 5
let x1 = y1
let y2 = data 0 1 2 3 4 5
let x2 = y2
let y3 = data 1 0
let x3 = data 0 1
plot y1 vs x1 and
plot y2 vs x2 and
plot y3 vs x3
.
window corner coordinates 0 50 100 100
justification left
height 6
move 25 80
text Question 1: C   n = m
move 25 70
text Question 2: 0   n <= m
move 25 60
text Question 3: 1   n >= 1
move 25 50
text Question 4: 0   n >= 1 - m
move 25 40
text Simplest Case: n = 1, m = 1 (linear/linear)
.
device 2 close
system mv SHAPE4.PS shape4.ps
.
