dimension 20 variables
.
device 1 x11
set ipl1na shape8.ps
device 2 postscript
.
let a0 = 0
let a1 = 0
let a2 = 1
let b1 = 0
let b2 = 0
let b3 = 0
let function fnum = (a0 + a1*x + a2*x**2)
let function fden = (1)
let function f = fnum/fden
.
window corner coordiantes 0 0 50 50
tic marks off
tic mark labels off
y2frame off
x2frame off
xlabel x
y1label y
ylimits 0 25
xlimits 0 5
label size 6
tic label size 6
plot f for x = 0 .01 5
limits
.
window corner coordiantes 50 0 100 50
pre-erase off
tic offset 0 0.2
x1tic mark labels on
y1tic mark labels on
xlabel m
y1label n
label size 6
character size 12
grid on
grid pattern solid
limits 0 5
major tic mark number 6
minor tic mark number 0
lines dash dash dash dash blank blank blank blank
line thickness 0.1 0.1 0.1 0.3
character blank blank blank blank circle circle circle circle
character fill on all
let y1 = data 1 5
let x1 = data 0 4
let y2 = data 2 5
let x2 = data 0 3
let y3 = data 1 0
let x3 = data 0 1
let y4 = data 1 1
let x4 = data 0 5
let y5 = data 2 3 4 5
let x5 = data 0 1 2 3
let y6 = data 3 4 5
let x6 = data 0 1 2
let y7 = data 4 5
let x7 = data 0 1
let y8 = data 5
let x8 = data 0
plot y1 vs x1 and
plot y2 vs x2 and
plot y3 vs x3 and
plot y4 vs x4 and
plot y5 vs x5 and
plot y6 vs x6 and
plot y7 vs x7 and
plot y8 vs x8
.
window corner coordinates 0 50 100 100
justification left
height 6
move 25 80
text Question 1: Infinity   n >= m + 1
move 25 70
text Question 2: Infinity   n >= m + 2
move 25 60
text Question 3: 1   n >= 1
move 25 50
text Question 4: 0   n >= 1 - m
move 25 40
text Simplest Case: n = 2, m = 0
move 30 33
text (quadratic/constant)
.
device 2 close
system mv SHAPE8.PS shape8.ps
.
