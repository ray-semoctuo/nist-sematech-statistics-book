device 1 x11
substitute character @
pre-erase off
.
let function fnum = P1 + P2*x + P3*x**2 + P4*x**3
let function fden = 1 + P5*x + P6*x**2
let function f = (fnum)/(fden)
.
xlabel x
y1label y
x1label displacement 11
y1label displacement 10
multiplot scale factor 2.5
title size 2.2
.
erase
device 2 postscript
.
multiplot 2 2
multiplot corner coordinates 2 2 98 98
.
let p1 = 1
let p2 = -5/6
let p3 = -1/3
let p4 = 1/6
let p5 = 0.5
let p6 = -0.5
title y = (1 - (5/6)x - (1/3)x^2 + (1/6)x^3)/(1 + 0.5x - 0.5x^2)
.
ylimits -10 10
plot f for x = -10 0.01 -1.05 and
plot f for x = -0.95 0.01 1.95 and
plot f for x = 2.05 0.01 10
line dash
drawdata -1 -10 -1 10
drawdata 2 -10 2 10
line solid
ylimits
.
let p1 = 1
let p2 = 2
let p3 = 3
let p4 = 1
let p5 = 0.5
let p6 = -0.5
title y = (1 + 2x + 3x^2 + x^3)/(1 + 0.5x - 0.5x^2)
.
ylimits -200 200
plot f for x = -10 0.01 -1.05 and
plot f for x = -0.95 0.01 1.95 and
plot f for x = 2.05 0.01 10
line dash
drawdata -1 -200 -1 200
drawdata 2 -200 2 200
line solid
ylimits
.
let p1 = 1
let p2 = -2
let p3 = 3
let p4 = -1
let p5 = -1.5
let p6 = 0.5
title y = (1 - 2x + 3x^2 - x^3)/(1 - 1.5x + 0.5x^2)
.
ylimits -30 30
plot f for x = -10 0.01 0.95 and
plot f for x = 1.05 0.01 1.95 and
plot f for x = 2.05 0.01 10
line dash 
drawdata 1 -30 1 30
drawdata 2 -30 2 30
line solid
ylimits
.
let p1 = 1
let p2 = 2
let p3 = -3
let p4 = 1
let p5 = -1.5
let p6 = 0.5
title y = (1 + 2x - 3x^2 + x^3)/(1 - 1.5x + 0.5x^2)
.
ylimits -30 30
plot f for x = -10 0.01 0.95 and
plot f for x = 1.05 0.01 1.95 and
plot f for x = 2.05 0.01 10
line dash 
drawdata 1 -30 1 30
drawdata 2 -30 2 30
line solid
ylimits
.
end of multiplot
title size
.
device 2 close
system cp dppl1f.dat r32p1.ps
.
erase
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = -1
let p6 = 1
title y = (4 + 2x + 7x^2 - 2x^3)/(1 - x + x^2)
plot f for x = -5 0.01 5
.
device 2 close
system cp dppl1f.dat r32p2.ps
.
erase
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = 1
let p6 = -1
.
ylimits -100 100
title y = (4 + 2x + 7x^2 - 2x^3)/(1 + x - x^2)
plot f for x = -5 0.01 -0.62 and
plot f for x = -0.61 0.01 1.6 and
plot f for x = 1.61 0.01 5
ylimits
.
device 2 close
system cp dppl1f.dat r32p3.ps
.
erase
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = -2
let p6 = 1
title y = (4 + 2x + 7x^2 - 2x^3)/(1 - 2x + x^2)
.
ylimits -50 150
.
plot f for x = -5 0.01 0.9 and
plot f for x = 1.1 0.01 5
.
ylimits
.
device 2 close
system cp dppl1f.dat r32p4.ps
.
erase
device 2 postscript
.
let p1 = 4
let p2 = 2
let p3 = 7
let p4 = -2
let p5 = 1/4
let p6 = -1/8
title y = (4 + 2x + 7x^2 - 2x^3)/(1 + (1/4)x - (1/8)x^2)
.
ylimits -500 500
plot f for x = -10 0.01 -2.1 and
plot f for x = -1.9 0.01 3.95 and
plot f for x = 4.05 0.01 10
.
ylimits
.
device 2 close
system cp dppl1f.dat r32p5.ps
.
pause
stop
.
