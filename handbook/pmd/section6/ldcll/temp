nl
#
flb <- function(load) 
{
sd <- sqrt(1 + c(1,load,load^2)%*%lfs$cov.unscaled%*%c(1,load,load^2))
f(load) + qt(0.975,lf$df)*lfs$sigma*sd
}
nllb <- uniroot(flb,c(1500000,2000000))$root
fub <- function(load) 
{
sd <- sqrt(1 + c(1,load,load^2)%*%lfs$cov.unscaled%*%c(1,load,load^2))
f(load) - qt(0.975,lf$df)*lfs$sigma*sd
}
nlub <- uniroot(fub,c(1500000,2000000))$root
c(nllb,nl,nlub)
