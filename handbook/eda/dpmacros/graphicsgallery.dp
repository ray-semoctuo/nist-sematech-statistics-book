write "--------------- 8. contour plot XX.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
. skip 25
. SERIAL READ WOOLLEY.DAT Y
. LET SECTOR = 1 31 1 31
. LET BAND = 1 1 31 FOR I = 1 1 961
. LET Y2 = SEQUENCE 14 .1 15
let x = sequence 1 10 1 10
let y = sequence 1 1 10 for i = 1 1 100
let z = (x-5.5)**2 + (y-5.5)**2
let z0 = sequence 0 5 200
.
title Contour Plot
y1label Y
x1label X
. x3label automatic
.
contour plot z x y z0
.
. let string mark = WOOLLEY.DAT
. call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat contourp.ps
.
reset variables clsb limits
.
