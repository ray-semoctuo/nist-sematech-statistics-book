. This is Dataplot Program file    graphicsgallery.dp
. Purpose--Generate WWW Graphics gallery Plots
. June 1996
.
. -----Start Point-----
.
device 1 x11
.
.  Jim's dplogf.tex defaults
.
SET MINMAX MIN
CHARACTER MAPPING RANK
TIC OFFSET UNITS SCREEN
TIC OFFSET 5 5
TITLE DISPLACEMENT 2
DIMENSION 40 VARIABLES
SET WRITE DECIMALS 2
CASE ASIS
TITLE CASE ASIS
LABEL CASE ASIS
TIC LABEL CASE ASIS
CHARACTER CASE ASIS ALL
LEGEND CASE ASIS
.
title size 4
label cases asis
label size 4
tic label size 4
legend size 4
.
write " "
write "---------------1. 4-plot LEW.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 25
read LEW.DAT y
.
x3label automatic
4-plot y
x3label
.
justification center
hw 5 4
move 50 95; text 4-plot
.
let string mark = LEW.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat 4plot.ps
. copy dppl1f.dat 4plot.ps
.
reset variables clsb limits
.
write " "
write "--------------- 2. 6-plot PONTIUS.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 25
read PONTIUS.DAT y x
.
title
. x3label automatic
.
linear fit y x
6-plot y x
.
justification center
hw 5 4
move 50 95; text 6-plot
.
let string mark = PONTIUS.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat 6plot.ps
.
reset variables clsb limits
.
write " "
write "--------------- 3. autocorrelation plot FLICKER.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 25
read FLICKER.DAT Y
.
title Autocorrelation Plot
y1label Autocorrelation
x1label Lag
. x3label automatic
.
autocorrelation plot y
.
let string mark = FLICKER.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat autocopl.ps
.
reset variables clsb limits
.
write " "
write "--------------- 3. bihistogram JAHANMI2.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 50
read JAHANMI2.DAT run lab bar set y x1 to x8 batch
let y1 = y
let y2 = y
retain y1 subset batch 1
retain y2 subset batch 2
.
title Bihistogram
y1label Counts
x1label Ceramic Strength
. x3label automatic
.
legend 1 batch 1
legend 2 batch 2
legend 1 coordinates 20 84
legend 2 coordinates 20 23
.
bihistogram y1 y2
.
legend 1
legend 2
.
let string mark = JAHANMI2.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat bihistog.ps
.
reset variables clsb limits
.
write " "
write "--------------- 4. block plot SHEESLE2.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 25
read SHEESLE2.DAT y weld plant speed shift
.
title Block Plot
y1label Average Defects per Hour
x1label Plant(2) x Speed(2) X Shift(3)
. x3label automatic
.
characters 1 2
lines blank blank
x1tic labels off; x1tics off
.
legend 1 Plot Character = Weld Method(2)
legend 1 coordinates 16 86
block plot y plant speed shift weld
legend 1
.
x1tic labels on; x1tics on
.
let string mark = SHEESLE2.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat blockplo.ps
.
reset variables clsb limits
.
write " "
write "--------------- 5. box plot PBF11.DAT ---------------"
write " "
.
device 2 postscript
. orientation portrait
.
skip 50
read PBF11.DAT year day j1 j2 f11 flag wv co2
retain year day j1 j2 f11 wv co2 flag subset flag 0
let x = int(day/31)+1
.
title Box Plot
y1label Water Vapor Concentration
x1label Month
. x3label automatic
.
characters box plot
lines box plot
.
xlimits 1 12
box plot wv x
xlimits
.
let string mark = PBF11.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp dppl1f.dat boxplot.ps
.
reset variables clsb limits
.
