. This is file    histogra.dp
. Create GIF files for a histogram
.
DEVICE 1 X11
.
TITLE Histogram
TITLE DISPLACEMENT 2
TITLE SIZE 4
LABEL CASE ASIS
Y1LABEL Counts
X1LABEL Y
. X3LABEL AUTOMATIC
LABEL SIZE 4
TIC LABEL SIZE 4
THICKNESS 0.2
.
CHARACTERS X
LINES BLANK
PRE-ERASE OFF
.
. -----CASE 0--TYPICAL HISTOGRAM (MICHELSO.DAT)
.
ERASE
SET IPL1NA HISTOGR0.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MICHELSO.DAT Y
MAJOR YTIC MARK NUMBER 6
MAJOR XTIC MARK NUMBER 5
XLIMITS 299.4 300.2
HISTOGRAM Y
LET STRING MARK = MICHELSO.DAT
MAJOR TIC MARK NUMBER
XLIMITS
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
MAJOR TIC MARK NUMBER 6
JUST LEFT
HEIGHT
system mv HISTOGR0.PS histogr0.ps
.
. -----CASE 1--NORMAL (ZARR13.DAT)
.
ERASE
SET IPL1NA HISTOGR1.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ ZARR13.DAT Y
HISTOGRAM Y
LET STRING MARK = ZARR13.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR1.PS histogr1.ps
.
. -----CASE 2--SYMMETRIC SHORT-TAILED (GENERATED)
.
ERASE
SET IPL1NA HISTOGR2.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
LET LAMBDA = 1.1
LET Y = TUKEY RANDOM NUMBERS FOR I = 1 1 100
HISTOGRAM Y
. LET STRING MARK = ZARR14.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR2.PS histogr2.ps
.
. -----CASE 3--SYMMETRIC LONG-TAILED (DZIUBA.DAT)
.
ERASE
SET IPL1NA HISTOGR3.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ DZIUBA.DAT JUNK Y
HISTOGRAM Y
LET STRING MARK = DZIUBA.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
DELETE JUNK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR3.PS histogr3.ps
.
. -----CASE 4--SYMMETRIC BIMODAL (LEW.DAT)
.
ERASE
SET IPL1NA HISTOGR4.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ LEW.DAT Y
HISTOGRAM Y
LET STRING MARK = LEW.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR4.PS histogr4.ps
.
. -----CASE 5--BIMODAL MIXTURE OF 2 NORMALS (ZARR14.DAT)
.
ERASE
SET IPL1NA HISTOGR5.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ ZARR14.DAT Y
YTIC OFFSET 0 2
TIC OFFSET UNITS DATA
HISTOGRAM Y
YTIC OFFSET 0 0
LET STRING MARK = ZARR14.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR5.PS histogr5.ps
.
. -----CASE 6--SKEWED RIGHT (SUNSPOT.DAT)
.
ERASE
SET IPL1NA HISTOGR6.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ SUNSPOT.DAT Y
HISTOGRAM Y
LET STRING MARK = SUNSPOT.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR6.PS histogr6.ps
.
. -----CASE 7--SKEWED LEFT (MORALES.DAT)
.
ERASE
SET IPL1NA HISTOGR7.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MORALES.DAT Y
HISTOGRAM Y
LET STRING MARK = MORALES.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR7.PS histogr7.ps
.
. -----CASE 8--SYMMETRIC WITH OUTLIER (ZARR13.DAT + OUTLIER)
.
ERASE
SET IPL1NA HISTOGR8.PS
DEVICE 2 POSTSCRIPT
DELETE Y Y2
SKIP 25
READ ZARR13.DAT Y
LET Y2(1) = 9.45
LET Y2(2) = 9.45
LET Y2(3) = 9.45
LET Y2(4) = 9.45
EXTEND Y Y2
HISTOGRAM Y
. LET STRING MARK = LEW.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv HISTOGR8.PS histogr8.ps
.
. -----ALL DONE-----
.
EXIT
