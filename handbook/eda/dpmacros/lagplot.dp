. This is file    lagplot.dp
. Create GIF files for a lag plot
.
echo on
.
DEVICE 1 X11
.
TITLE Lag Plot
TITLE SIZE 4
TITLE DISPLACEMENT 3
LABEL CASE ASIS
LABEL FONT SIMPLEX
Y1LABEL YSUB()i
X1LABEL YSUB()i-1
. X3LABEL AUTOMATIC
LABEL SIZE 4
X1LABEL DISPLACEMENT 10
THICKNESS 0.2
.
CHARACTERS X
LINES BLANK
PRE-ERASE OFF
.
. -----CASE 0--TYPICAL LAG PLOT
.
ERASE
SET IPL1NA LAGPLOT0.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MAVRO.DAT Y
CHARACTERS X
LINES BLANK
MAJOR TIC MARK NUMBER 5
TIC MARK DECIMALS 4
TIC LABEL SIZE 3.5
Y1LABEL DISPLACEMENT 11
FRAME CORNER COORDINATES 17 20 87 90
LAG PLOT Y
FRAME CORNER COORDINATES 15 20 85 90
MAJOR TIC MARK NUMBER
TIC MARK DECIMALS
Y1LABEL DISPLACEMENT
TIC LABEL SIZE 4.0
LET STRING MARK = MAVRO.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv LAGPLOT0.PS lagplot0.ps
.
. -----CASE 1--RANDOM
.
ERASE
SET IPL1NA LAGPLOT1.ps
DEVICE 2 POSTSCRIPT
DELETE Y
LET Y = NORMAL RANDOM NUMBERS FOR I = 1 1 200
LAG PLOT Y
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv LAGPLOT1.PS lagplot1.ps
.
. -----CASE 2--MODERATE AUTOCORRELATION
.
ERASE
SET IPL1NA LAGPLOT2.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ FLICKER.DAT Y
CHARACTERS X
LINES BLANK
LAG PLOT Y
LET STRING MARK = FLICKER.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv LAGPLOT2.PS lagplot2.ps
.
. -----CASE 3--STRONG AUTOCORRELATION
.
ERASE
SET IPL1NA LAGPLOT3.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ RANDWALK.DAT Y
CHARACTERS X
LINES BLANK
LAG PLOT Y
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
LET STRING MARK = FLICKER.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv LAGPLOT3.PS lagplot3.ps
.
. -----CASE 4--SINUSOIDAL MODEL
.
ERASE
SET IPL1NA LAGPLOT4.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ LEW.DAT Y
CHARACTERS X
LINES BLANK
TIC OFFSET UNITS SCREEN
TIC OFFSET 5 5
LAG PLOT Y
LET STRING MARK = LEW.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv LAGPLOT4.PS lagplot4.ps
.
EXIT
