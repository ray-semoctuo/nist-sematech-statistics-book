.
.  Create Postscript files (to be converted to gif)
.  for the Airplane glass failure time data.
.
device 1 x11
thickness 0.2
box shadow hw 0 0
.
call data.dp
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na hist.ps
device 2 post
call hist.dp
box 0 0 100 100
device 2 close
system mv HIST.PS hist.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na normprpl.ps
device 2 post
call normprpl.dp
box 0 0 100 100
device 2 close
system mv NORMPRPL.PS normprpl.ps
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na weibppcc.ps
device 2 post
call weibppcc.dp
box 0 0 100 100
device 2 close
system mv WEIBPPCC.PS weibppcc.ps
y1label displacement
frame corner coordinates
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
character size 4
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na lognppcc.ps
device 2 post
call lognppcc.dp
box 0 0 100 100
device 2 close
system mv LOGNPPCC.PS lognppcc.ps
y1label displacement
frame corner coordinates
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
character size 4
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na gammppcc.ps
device 2 post
call gammppcc.dp
box 0 0 100 100
device 2 close
system mv GAMMPPCC.PS gammppcc.ps
y1label displacement
frame corner coordinates
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
character size 4
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na flppcc.ps
device 2 post
call flppcc.dp
box 0 0 100 100
device 2 close
system mv FLPPCC.PS flppcc.ps
y1label displacement
frame corner coordinates
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
character size 4
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na pownppcc.ps
device 2 post
call pownppcc.dp
box 0 0 100 100
device 2 close
system mv POWNPPCC.PS pownppcc.ps
y1label displacement
frame corner coordinates
.
height 4
title size 4
label size 4
tic label size 4
legend size 4
character size 4
y1label displacement 10
set ipl1na weibplot.ps
device 2 post
call weibplot.dp
box 0 0 100 100
device 2 close
system mv WEIBPLOT.PS weibplot.ps
.
height 4
title size 4
label size 4
tic label size 4
legend size 4
character size 4
y1label displacement 10
set ipl1na weibhaza.ps
device 2 post
call weibhaza.dp
box 0 0 100 100
device 2 close
system mv WEIBHAZA.PS weibhaza.ps
.
title size 6
label size 6
tic label size 6
legend size 6
height 7
character size 4
y1label displacement 15
x1label displacement 10
frame corner coordinates 20 20 90 90
set ipl1na powlppcc.ps
device 2 post
call powlppcc.dp
box 0 0 100 100
device 2 close
system mv POWLPPCC.PS powlppcc.ps
y1label displacement
frame corner coordinates
.
quit
