.
.  Generate sample output for confidence limits
.
device 1 x11
device 1 font simplex
set ipl1na location.ps
device 2 postscript
.
let y1 = normal random numbers for i = 1 1 10000
let a1 = mean y1
let b1 = median y1
.
let y2 = exponential random numbers for i = 1 1 10000
let a2 = mean y2
let b2 = median y2
let y3 = cauchy random numbers for i = 1 1 10000
let a3 = mean y3
let b3 = median y3
let y4 = lognormal random numbers for i = 1 1 10000
let a4 = mean y4
let b4 = median y4
multiplot corner coordiantes 2 2 98 98
multiplot 2 2
legend 1 coordinates 16 82
legend 2 coordinates 16 77
legend size 5
label size 5
x1label size 6
title size 6
tic mark label size 5
height 4
.
title normal random numbers
x1label mean = ^a1, median = ^b1
histogram y1
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c1 = junk(1)
move 16 72
. text mode = ^c1
.
x1label mean = ^a2, median = ^b2
title exponential random numbers
histogram y2
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c2 = junk(1)
move 16 72
. text mode = ^c2
.
title cauchy random numbers
X1label mean = ^a3, median = ^b3
let atemp = standard deviation y4
let atemp = 0.1*atemp
class width atemp
class width 0.5
class width
histogram y3
class width
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c3 = junk(1)
move 16 72
. text mode = ^c3
.
.
title lognormal random numbers
x1label mean = ^a4, median = ^b4
histogram y4
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c4 = junk(1)
move 16 72
. text mode = ^c4
.
end of multiplot
.
device 2 close
system cp LOCATION.PS location.ps
.
quit
