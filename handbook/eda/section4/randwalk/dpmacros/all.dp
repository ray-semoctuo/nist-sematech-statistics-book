.
.  Create Postscript files (to be converted to gif)
.  for the Random Walk plots.
.
device 1 x11
thickness 0.2
box shadow hw 0 0
call data.dp
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na randwa4p.ps
device 2 postscript
call 4plot.dp
box 0 0 100 100
device 2 close
system mv RANDWA4P.PS randwa4p.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na runseq.ps
device 2 postscript
call runseq.dp
box 0 0 100 100
device 2 close
system mv RUNSEQ.PS runseq.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na lagplot.ps
device 2 postscript
call lagplot.dp
box 0 0 100 100
device 2 close
system mv LAGPLOT.PS lagplot.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na autocorr.ps
device 2 postscript
call autocorr.dp
box 0 0 100 100
device 2 close
system mv AUTOCORR.PS autocorr.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na spectrum.ps
device 2 postscript
call spectrum.dp
box 0 0 100 100
device 2 close
system mv SPECTRUM.PS spectrum.ps
.
call ar.dp
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na 4plotres.ps
device 2 postscript
call 4plotres.dp
box 0 0 100 100
device 2 close
system mv 4PLOTRES.PS 4plotres.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na unifprpl.ps
device 2 postscript
call unifprpl.dp
box 0 0 100 100
device 2 close
system mv UNIFPRPL.PS unifprpl.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na normprpl.ps
device 2 postscript
call normprpl.dp
box 0 0 100 100
device 2 close
system mv NORMPRPL.PS normprpl.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na plotpred.ps
device 2 postscript
call plotpred.dp
box 0 0 100 100
device 2 close
system mv PLOTPRED.PS plotpred.ps
.
title size 4
label size 4
tic label size 4
legend size 4
set ipl1na 4plotres.ps
device 2 postscript
call 4plotres.dp
box 0 0 100 100
device 2 close
system mv 4PLOTRES.PS 4plotres.ps
.
quit
