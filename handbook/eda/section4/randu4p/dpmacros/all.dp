device 1 x11
thickness 0.2
box shadow hw 0 0 
.
call data.dp
.
label size 4
tic label size 4
legend size 4
set ipl1na 4plot.ps
device 2 postscript
call 4plot.dp
box 0 0 100 100
device 2 close
system mv 4PLOT.PS 4plot.ps
.
