.
.  Generate sample output for Normal Hazard plot
.
device 1 x11
device 1 font simplex
set ipl1na norhaz.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Normal Hazard
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Hazard
X1LABEL X
.
PLOT NORHAZ(X) FOR X = -4 0.01 4
.
box 0 0 100 100
.
device 2 close
system cp NORHAZ.PS norhaz.ps
system rm NORHAZ.PS
.
quit
