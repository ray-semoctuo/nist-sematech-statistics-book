.
.  Generate sample output for Exponential Hazard plot
.
device 1 x11
device 1 font simplex
set ipl1na exphaz.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Exponential Hazard
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
Y1LABEL Hazard
X1LABEL X
.
PLOT EXPHAZ(X) FOR X = 0.01 0.01 5
.
box 0 0 100 100
.
device 2 close
system cp EXPHAZ.PS exphaz.ps
system rm EXPHAZ.PS
.
quit
