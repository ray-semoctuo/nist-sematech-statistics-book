.
.  Generate sample output for Exponential Inverse Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na expisurv.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Exponential Inverse Survival
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
PLOT EXPPPF(1-P) FOR P = 0.01 0.01 0.99
.
box 0 0 100 100
.
device 2 close
system cp EXPISURV.PS expisurv.ps
system rm EXPISURV.PS
.
quit
