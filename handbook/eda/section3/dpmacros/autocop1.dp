. This is file    autocop1.dp
. Create GIF files for a autocorrelation plots
.
DEVICE 1 X11
device 1 font simplex
.
TITLE Autocorrelation Plot
TITLE SIZE 4
LABEL CASE ASIS
Y1LABEL Autocorrelation
X1LABEL Lag
.
TITLE DISPLACMENT 2
LABEL SIZE 4
TIC LABEL SIZE 4
HEIGHT 3.5
TIC MARK LABEL SIZE 3.5
THICKNESS 0.2
.
XTIC OFFSET 0.5 0.5
YTIC OFFSET 0.1 0.1
.
SPIKE BASE 0
SPIKE ON
LINE BLANK SOLID DASH DASH DASH DASH
CHARACTERS BLANK ALL
.
. -----CASE 0--TYPICAL AUTOCORRELATION PLOT
.
ERASE
SET IPL1NA AUTOCOP0.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MAVRO.DAT Y
AUTOCORRELATION PLOT Y
LET STRING MARK = MAVRO.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv AUTOCOP0.PS autocop0.ps
.
. -----CASE 1--RANDOM
.
SET IPL1NA AUTOCOP1.PS
DEVICE 2 POSTSCRIPT
DELETE Y
LET Y = NORMAL RANDOM NUMBERS FOR I = 1 1 200
AUTOCORRELATION PLOT Y
LET STRING MARK = RANDOM
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv AUTOCOP1.PS autocop1.ps
.
. -----CASE 2--MODERATE AUTOCORRELATION
.
ERASE
SET IPL1NA AUTOCOP2.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ FLICKER.DAT Y
XLIMITS 0 250
AUTOCORRELATION PLOT Y
XLIMITS
LET STRING MARK = FLICKER.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv AUTOCOP2.PS autocop2.ps
.
. -----CASE 3--STRONG AUTOCORRELATION
.
ERASE
SET IPL1NA AUTOCOP3.ps
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
XLIMITS 0 125
READ RANDWALK.DAT Y
AUTOCORRELATION PLOT Y
XLIMITS
LET STRING MARK = RANDWALK.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv AUTOCOP3.PS autocop3.ps
.
. -----CASE 4--SINUSOIDAL MODEL
.
ERASE
SET IPL1NA AUTOCOP4.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ LEW.DAT Y
AUTOCORRELATION PLOT Y
LET STRING MARK = LEW.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv AUTOCOP4.PS autocop4.ps
.
EXIT
