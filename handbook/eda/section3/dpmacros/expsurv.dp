.
.  Generate sample output for Exponential Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na expsurv.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Exponential Survival
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
PLOT 1 - EXPCDF(X) FOR X = 0.01 0.01 5
.
box 0 0 100 100
.
device 2 close
system cp EXPSURV.PS expsurv.ps
system rm EXPSURV.PS
.
quit
