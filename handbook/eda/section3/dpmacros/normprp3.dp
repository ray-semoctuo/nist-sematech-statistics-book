.
.  Generate normal probability plot
.
device 1 x11
device 1 font simplex
set ipl1na normprp3.ps
device 2 postscript
.
. LET Y = LOGISTIC RANDOM NUMBERS FOR I = 1 1 100
LET Y = DOUBLE EXPONENTIAL RANDOM NUMBERS FOR I = 1 1 500
.
TITLE Double Exponential Random Numbers
TITLE SIZE 4
TITLE DISPLACEMENT 2
LABEL CASE ASIS
X1LABEL Theoretical
Y1LABEL Data
LABEL SIZE 4
TIC LABEL SIZE 4
CHARACTER SIZE 1.5
CHARACTER CIRCLE BLANK
LINE BLANK SOLID
THICKNESS 0.2
.
NORMAL PROBABILITY PLOT Y
LINE SOLID
CHARACTER BLANK
.  LET X1 = XPLOT(1)
.  LET Y1 = YPLOT(1)
.  LET N = SIZE XPLOT SUBSET TAGPLOT = 1
.  LET X2 = XPLOT(N)
.  LET Y2 = YPLOT(N)
.  DRAWDATA X1 Y1 X2 Y2
LET FUNCTION F = PPA0 + PPA1*X
LET X = DATA -3 3
LET Y2 = F
LIMITS FREEZE
PRE-ERASE OFF
PLOT Y2 X
HEIGHT 4
JUSTIFICATION CENTER
MOVE 50 4
LET A1 = ROUND(PPCC,4)
LET A2 = ROUND(PPA0,4)
LET A3 = ROUND(PPA1,4)
TEXT CORRELATION = ^A1, INTERCEPT = ^A2, SLOPE = ^A3
.
box 0 0 100 100
.
device 2 close
system mv NORMPRP3.PS normprp3.ps
.
capture junk.dat
echo on
let a = mean y
let a = sd y
end of capture
. quit
