.
.  Generate sample output for F PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na fppf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
Y1LABEL DISPLACEMENT 15
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE F PPF (1, 1 df)
PLOT FPPF(P,1,1) FOR P = 0.01 0.01 0.99
TITLE F PPF (1, 10 df)
PLOT FPPF(P,1,10) FOR P = 0.01 0.01 0.99
TITLE F PPF (10, 1 df)
PLOT FPPF(P,10,1) FOR P = 0.01 0.01 0.99
TITLE F PPF (10, 10 df)
PLOT FPPF(P,10,10) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
device 2 close
system mv FPPF4.PS fppf4.ps
.
quit
