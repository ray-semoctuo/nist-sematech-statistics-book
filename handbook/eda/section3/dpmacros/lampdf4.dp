.
.  Generate sample output for Tukey-Lambda PDF plot
.
device 1 x11
device 1 font simplex
set ipl1na lampdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
Y1LABEL Probability Density
X1LABEL X
Y1LABEL DISPLACEMENT 13
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Tukey-Lambda PDF (Lambda = -1)
LET TEMP = -1
PLOT LAMPDF(X,TEMP) FOR X = -5 0.01 5
TITLE Tukey-Lambda PDF (Lambda = 0.14)
PLOT LAMPDF(X,0.14) FOR X = -5 0.01 5
TITLE Tukey-Lambda PDF (Lambda = 0.5)
PLOT LAMPDF(X,0.5) FOR X = -2 0.01 2
TITLE Tukey-Lambda PDF (Lambda = 5)
PLOT LAMPDF(X,5) FOR X = -0.2 0.01 0.2
.
END OF MULTIPLOT
.
box 0 0 100 100
device 2 close
system mv LAMPDF4.PS lampdf4.ps
.
quit
