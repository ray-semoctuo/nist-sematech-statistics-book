.
.  Generate sample output for Poisson CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na poicdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE DISPLACEMENT 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
Y1LABEL DISPLACEMENT 13
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
LINE BLANK
SPIKE ON
XTIC OFFSET 2 2
.
TITLE Poisson CDF (LAMBDA = 5)
PLOT POICDF(X,5) FOR X = 0 1 50
TITLE Poisson CDF (LAMBDA = 15)
PLOT POICDF(X,15) FOR X = 0 1 50
TITLE Poisson CDF (LAMBDA = 25)
PLOT POICDF(X,25) FOR X = 0 1 50
TITLE Poisson CDF (LAMBDA = 35)
PLOT POICDF(X,35) FOR X = 0 1 50
.
END OF MULTIPLOT
.
box 0 0 100 100
device 2 close
system mv POICDF4.PS poicdf4.ps
.
quit
