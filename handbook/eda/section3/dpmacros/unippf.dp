.
.  Generate sample output for Uniform PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na unippf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Uniform PPF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
X1LABEL Probability
Y1LABEL X
.
PLOT UNIPPF(P) FOR P = 0 0.1 1
.
box 0 0 100 100
.
device 2 close
system cp UNIPPF.PS unippf.ps
system rm UNIPPF.PS
.
quit
