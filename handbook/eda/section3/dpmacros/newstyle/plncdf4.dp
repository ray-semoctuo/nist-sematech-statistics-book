.
.  Generate sample output for Power Lognormal CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na plncdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Power Lognormal CDF (p = 0.5, sd = 1)
PLOT PLNCDF(X,0.5) FOR X = 0.01 0.01 5
TITLE Power Lognormal CDF (p = 1, sd = 1)
PLOT PLNCDF(X,1) FOR X = 0.01 0.01 5
TITLE Power Lognormal CDF (p = 5, sd = 1)
PLOT PLNCDF(X,5) FOR X = 0.01 0.01 5
TITLE Power Lognormal CDF (p = 10, sd = 1)
PLOT PLNCDF(X,10) FOR X = 0.01 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp PLNCDF4.PS plncdf4.ps
system rm PLNCDF4.PS
.
quit
