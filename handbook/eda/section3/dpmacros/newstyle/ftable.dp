.
.  Macro to generate F PPF Table.  List to 3
.  digits.
.
.  Table is in multiple parts:
.    1) Generate for different values of alpha
.    2) Generate for v1 = 1-10. 11-20
.    3) Generate for v2 = 1 - 100
.
. cd f:\handbook\eda\section3\dpmacros
let alpha = data 0.10 0.05 0.025 0.01 0.001
let alpha = 1 - alpha
set write rewind off
set write format f4.0,5x,10(f7.3,1x)
.
let string s1 = fppf
let string s3 = a.out
let string s4 = b.out
let string t1 = 10
let string t2 = 05
let string t3 = 025
let string t4 = 01
let string t5 = 001
feedback off
let nalpha = size alpha
loop for k = 1 1 nalpha
    let alphat = alpha(k)
.   let v1 = sequence 1 1 10
    let v1 = sequence 11 1 20
    let string s2 = ^t^k
.   let string fname1 = ^s1&^s2&^s3
    let string fname2 = ^s1&^s2&^s4
.   write ^fname1 "Alpha = ^alphat"
    write ^fname2 "Alpha = ^alphat"
    loop for v2 = 1 1 100
       let ytemp = fppf(alphat,v1,v2)
       let b1 = ytemp(1)
       let b2 = ytemp(2)
       let b3 = ytemp(3)
       let b4 = ytemp(4)
       let b5 = ytemp(5)
       let b6 = ytemp(6)
       let b7 = ytemp(7)
       let b8 = ytemp(8)
       let b9 = ytemp(9)
       let b10 = ytemp(10)
.      write ^fname1 v2 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10
       write ^fname2 v2 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10
    end of loop
end of loop
.
quit
