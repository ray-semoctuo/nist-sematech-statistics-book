.
.  Generate sample output for Lognormal PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na lgnppf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Lognormal PPF (sd = 0.5)
PLOT LGNPPF(P,0.5) FOR P = 0.01 0.01 0.99
TITLE Lognormal PPF (sd = 1)
PLOT LGNPPF(P,1) FOR P = 0.0 0.01 0.99
TITLE Lognormal PPF (sd = 2)
PLOT LGNPPF(P,2) FOR P = 0.01 0.01 0.99
TITLE Lognormal PPF (sd = 5)
PLOT LGNPPF(P,5) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp LGNPPF4.PS lgnppf4.ps
system rm LGNPPF4.PS
.
quit
