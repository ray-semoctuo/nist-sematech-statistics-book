.
.  Generate sample output for Lognormal Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na lgnsurv4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Lognormal Survival (sd = 0.5)
PLOT 1 - LGNCDF(X,0.5) FOR X = 0.01 0.01 5
TITLE Lognormal Survival (sd = 1)
PLOT 1 - LGNCDF(X,1) FOR X = 0.0 0.01 5
TITLE Lognormal Survival (sd = 2)
PLOT 1 - LGNCDF(X,2) FOR X = 0.01 0.01 5
TITLE Lognormal Survival (sd = 5)
PLOT 1 - LGNCDF(X,5) FOR X = 0.01 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp LGNSURV4.PS lgnsurv4.ps
system rm LGNSURV4.PS
.
quit
