.
.  Generate sample output for Uniform CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na unicdf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Uniform CDF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Probability
X1LABEL X
.
PLOT UNICDF(X) FOR X = 0 0.1 1
.
box 0 0 100 100
.
device 2 close
system cp UNICDF.PS unicdf.ps
system rm UNICDF.PS
.
quit
