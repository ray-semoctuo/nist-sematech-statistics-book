.
.  Generate sample output for Tukey-Lambda PDF plot
.
device 1 x11
device 1 font simplex
set ipl1na lampdf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Tukey-Lambda PDF (Lambda = 0.14)
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Probability
X1LABEL X
.
PLOT LAMPDF(X,0.14) FOR X = -3 0.01 3
.
box 0 0 100 100
.
device 2 close
system cp LAMPDF.PS lampdf.ps
system rm LAMPDF.PS
.
quit
