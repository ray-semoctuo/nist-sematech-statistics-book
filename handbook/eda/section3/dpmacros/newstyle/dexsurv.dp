.
.  Generate sample output for Double Exponetial Survival plot
.
device 1 x11
device 1 font simplex
pre-erase off
erase
set ipl1na dexsur.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Double Exponential Survival
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Survival
X1LABEL X
.
PLOT 1-DEXCDF(X) FOR X = -5 0.01 5
.
. box 0 0 100 100
.
device 2 close
system mv DEXSUR.PS dexsur.ps
.
quit
