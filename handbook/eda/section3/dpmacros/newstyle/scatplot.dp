. This is file    scatplot.dp
.  Create a GIF file for a run sequence plot
.
DEVICE 1 X11
.
TITLE Scatter Plot
TITLE SIZE 4
LABEL CASE ASIS
Y1LABEL Y
X1LABEL X
. X3LABEL AUTOMATIC
LABEL SIZE 4
TIC LABEL SIZE 4
.
CHARACTERS X
LINES BLANK
PRE-ERASE OFF
.
. -----CASE 0--TYPICAL SCATTER PLOT
.
ERASE
SET IPL1NA SCATPLO0.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
PLOT Y X
LET STRING MARK = LEW3.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO00.PS scatplot00.ps
.
. -----CASE 1--NO RELATIONSHIP
.
ERASE
SET IPL1NA SCATPLO1.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
LET Y = NORMAL RANDOM NUMBERS FOR I = 1 1 200
LET X = NORMAL RANDOM NUMBERS FOR I = 1 1 200
PLOT Y X
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO01.PS scatplot01.ps
.
. -----CASE 2--STRONG LINEAR RELATIONSHIP (POSITIVE CORRELATION)
.
ERASE
SET IPL1NA SCATPLO2.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
LINEAR FIT Y X
CHAR X BLANK
LINES BLANK SOLID
LINE COLOR RED RED
PLOT Y PRED VERSUS X
LET STRING MARK = LEW3.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO02.PS scatplot02.ps
.
. -----CASE 3--STRONG LINEAR RELATIONSHIP (NEGATIVE CORRELATION)
.
ERASE
SET IPL1NA SCATPLO3.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
LET Y = -Y
LINEAR FIT Y X
CHAR X BLANK
LINES BLANK SOLID
LINE COLOR RED RED
PLOT Y PRED VERSUS X
LET STRING MARK = LEW3.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO03.PS scatplot03.ps
.
. -----CASE 4--EXACT LINEAR RELATIONSHIP (POSITIVE CORRELATION)
.
ERASE
SET IPL1NA SCATPLO4.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
LINEAR FIT Y X
PLOT PRED X
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO04.PS scatplot04.ps
.
. -----CASE 5--QUADRATIC RELATIONSHIP
.
ERASE
SET IPL1NA SCATPLO5.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
LET Y2 = Y**3
QUADRATIC FIT Y2 X
CHAR X BLANK
LINES BLANK SOLID
LINE COLOR RED RED
PLOT Y2 PRED VERSUS X
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO05.PS scatplot05.ps
.
. -----CASE 6--EXPONENTIAL RELATIONSHIP
.
ERASE
SET IPL1NA SCATPLO6.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ CHWIRUT2.DAT Y X
PLOT Y X
LET STRING MARK = CHWIRUT2.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO06.PS scatplot06.ps
.
. -----CASE 7--SINUOSOIDAL RELATIONSHIP
.
ERASE
SET IPL1NA SCATPLO7.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LUTHER.DAT Y
LET N = NUMBER Y
LET X = SEQUENCE 1 1 N
PLOT Y X FOR I = 1 1 200
LET STRING MARK = LUTHER.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO07.PS scatplot07.ps
.
. -----CASE 8--VARIATION OF Y NOT DEPEND ON X
.
ERASE
SET IPL1NA SCATPLO8.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ BERGER1.DAT Y X
LINEAR FIT Y X
LET N = NUMBER Y
LET ERROR = NORMAL RANDOM NUMBERS FOR I = 1 1 N
LET ERROR = 5*ERROR
LET Y2 = PRED+ERROR
CHAR X BLANK BLANK
LINES BLANK SOLID SOLID
LINE COLOR RED ALL
LET LOWER = PRED-10
LET UPPER = PRED+10
PLOT Y2 LOWER UPPER VERSUS X
HW .5 2
ARROW 20 27 20 42
ARROW 20 42 20 27
ARROW 78 84 78 69
ARROW 78 69 78 84
LINE COLOR BLACK ALL
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO08.PS scatplot08.ps
.
. -----CASE 9--VARIATION OF Y DEPENDS ON X
.
ERASE
SET IPL1NA SCATPLO9.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ BERGER1.DAT Y X
LINEAR FIT Y X
CHAR X
LINES BLANK
PLOT Y VERSUS X
LINES SOLID
LINE COLOR RED
DRAWDATA 3 0 85 50
DRAWDATA 3 5 85 88
HW .5 2
ARROW 20 23 20 28
ARROW 20 28 20 23
ARROW 78 84 78 59
ARROW 78 59 78 84
LINE COLOR BLACK ALL
LET STRING MARK = BERGER1.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO09.PS scatplot09.ps
.
. -----CASE 10--OUTLIER
.
ERASE
SET IPL1NA SCATPLOA.PS
DEVICE 2 POSTSCRIPT
DELETE Y X
SKIP 25
READ LEW3.DAT Y X
DELETE Y X SUBSET X <= 0
RETAIN Y X SUBSET X > 175
LET Y = Y+10 FOR I = 15 1 15
CHAR X
LINES BLANK
PLOT Y X
. LET STRING MARK = LEW3.DAT
. CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
SYSTEM mv SCATPLO0A.PS scatplot0a.ps
.
QUIT
