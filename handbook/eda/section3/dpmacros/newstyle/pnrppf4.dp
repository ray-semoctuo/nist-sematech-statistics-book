.
.  Generate sample output for Power Normal PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na pnrppf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Power Normal PPF (p = 0.5, sd = 1)
PLOT PNRPPF(P,0.5) FOR P = 0.01 0.01 0.99
TITLE Power Normal PPF (p = 1, sd = 1)
PLOT PNRPPF(P,1) FOR P = 0.01 0.01 0.99
TITLE Power Normal PPF (p = 0.99, sd = 1)
PLOT PNRPPF(P,5) FOR P = 0.01 0.01 0.99
TITLE Power Normal PPF (p = 10, sd = 1)
PLOT PNRPPF(P,10) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp PNRPPF4.PS pnrppf4.ps
system rm PNRPPF4.PS
.
quit
