. This is file    spect1.dp
. Create GIF files for a spectral plots
.
DEVICE 1 X11
device 1 font simplex
.
TITLE Spectral Plot
TITLE SIZE 4
LABEL CASE ASIS
Y1LABEL Spectral Power
X1LABEL Frequency (cyles per observation)
LABEL SIZE 4
TIC LABEL SIZE 4
.
LINE SOLID
CHARACTERS BLANK ALL
.
. -----CASE 0--TYPICAL SPECTRAL PLOT
.
ERASE
SET IPL1NA SPECT0.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MAVRO.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = MAVRO.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT0.PS spect0.ps
.
. -----CASE 1--RANDOM
.
SET IPL1NA SPECT1.PS
DEVICE 2 POSTSCRIPT
DELETE Y
LET Y = NORMAL RANDOM NUMBERS FOR I = 1 1 200
SPECTRAL PLOT Y
LET STRING MARK = RANDOM
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT1.PS spect1.ps
.
. -----CASE 2--MODERATE AUTOCORRELATION
.
ERASE
SET IPL1NA SPECT2.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ FLICKER.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = FLICKER.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT2.PS spect2.ps
.
. -----CASE 3--STRONG AUTOCORRELATION
.
ERASE
SET IPL1NA SPECT3.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ RANDWALK.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = RANDWALK.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT3.PS spect3.ps
.
. -----CASE 4--SINUSOIDAL MODEL
.
ERASE
SET IPL1NA SPECT4.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ LEW.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = LEW.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT4.PS spect4.ps
.
EXIT
