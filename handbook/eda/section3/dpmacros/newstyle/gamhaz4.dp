.
.  Generate sample output for Gamma Hazard plot
.
device 1 x11
device 1 font simplex
set ipl1na gamhaz4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Hazard
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
XLIMITS 0 10
TITLE Gamma Hazard (0.5 df)
PLOT GAMHAZ(X,0.5) FOR X = 0.01 0.01 10
TITLE Gamma Hazard (1 df)
LET FUNCTION F = X/X
PLOT F FOR X = 0.01 0.01 10
TITLE Gamma Hazard (2 df)
PLOT GAMHAZ(X,2) FOR X = 0.01 0.01 10
TITLE Gamma Hazard (5 df)
PLOT GAMHAZ(X,5) FOR X = 0.01 0.01 10
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp GAMHAZ4.PS gamhaz4.ps
system rm GAMHAZ4.PS
.
quit
