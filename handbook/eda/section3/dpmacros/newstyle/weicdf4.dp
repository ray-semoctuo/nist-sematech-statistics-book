.
.  Generate sample output for Weibull CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na weicdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
SET MINMAX MIN
TITLE Weibull CDF (0.5 df)
PLOT WEICDF(X,0.5) FOR X = 0.01 0.01 5
TITLE Weibull CDF (1 df)
PLOT WEICDF(X,1) FOR X = 0.0 0.01 5
TITLE Weibull CDF (2 df)
PLOT WEICDF(X,2) FOR X = 0.01 0.01 5
TITLE Weibull CDF (5 df)
PLOT WEICDF(X,5) FOR X = 0.01 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp WEICDF4.PS weicdf4.ps
system rm WEICDF4.PS
.
. quit
