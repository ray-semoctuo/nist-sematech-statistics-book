.
.  Generate sample output for EV1 Inverse Survival plot
.
device 1 x11
device 1 font simplex
pre-erase off
erase
set ipl1na ev1isu.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Extreme Value Type I (Minimum) Inverse Survival
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
X1LABEL Probability
Y1LABEL X
.
SET MINMAX 1
PLOT EV1PPF(1-P) FOR P = 0.01 0.01 0.99
.
. box 0 0 100 100
.
device 2 close
system mv EV1ISU.PS ev1isu.ps
.
quit
