.
.  Generate sample output for Exponential PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na expppf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Exponential PPF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
PLOT EXPPPF(P) FOR P = 0.01 0.01 0.99
.
box 0 0 100 100
.
device 2 close
system cp EXPPPF.PS expppf.ps
system rm EXPPPF.PS
.
quit
