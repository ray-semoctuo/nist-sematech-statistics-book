.
.  Generate sample output for Binomial PPF plot
.
device 1 x11
device 1 font simplex
pre-erase off
erase
set ipl1na binpf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Binomial PPF (P=0.1, N=100)
PLOT BINPPF(X,0.1,100) FOR X = 0 0.01 1
TITLE Binomial PPF (P=0.25, N=100)
PLOT BINPPF(X,0.25,100) FOR X = 0 0.01 1
TITLE Binomial PPF (P=0.50, N=100)
PLOT BINPPF(X,0.50,100) FOR X = 0 0.01 1
TITLE Binomial PPF (P=0.75, N=100)
PLOT BINPPF(X,0.75,100) FOR X = 0 0.01 1
.
END OF MULTIPLOT
.
. box 0 0 100 100
.
device 2 close
system mv BINPF4.PS binpf4.ps
.
quit
