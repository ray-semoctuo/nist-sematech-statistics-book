.
.  Generate sample output for Gamma Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na gamsurv4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Gamma Survival (0.5 df)
PLOT 1 - GAMCDF(X,0.5) FOR X = 0.01 0.01 10
TITLE Gamma Survival (1 df)
PLOT 1 - GAMCDF(X,1) FOR X = 0.01 0.01 10
TITLE Gamma Survival (2 df)
PLOT 1 - GAMCDF(X,2) FOR X = 0.01 0.01 10
TITLE Gamma Survival (5 df)
PLOT 1 - GAMCDF(X,5) FOR X = 0.01 0.01 10
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp GAMSURV4.PS gamsurv4.ps
system rm GAMSURV4.PS
.
quit
