.
.  Generate sample output for Gamma PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na gamppf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Gamma PPF (0.5 df)
PLOT GAMPPF(P,0.5) FOR P = 0.01 0.01 0.99
TITLE Gamma PPF (1 df)
PLOT GAMPPF(P,1) FOR P = 0.01 0.01 0.99
TITLE Gamma PPF (2 df)
PLOT GAMPPF(P,2) FOR P = 0.01 0.01 0.99
TITLE Gamma PPF (5 df)
PLOT GAMPPF(P,5) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp GAMPPF4.PS gamppf4.ps
system rm GAMPPF4.PS
.
quit
