.
.  Generate sample output for box-cox normality plot
.
device 1 x11
device 1 font simplex
pre-erase off
erase
set ipl1na boxcox.ps
device 2 postscript
.
.
.  Jim's dplogf.tex settings
.
SET MINMAX MIN
CHARACTER MAPPING RANK
TIC OFFSET UNITS SCREEN
XTIC OFFSET 5 5
YTIC OFFSET 0 5
TITLE DISPLACEMENT 2
DIMENSION 40 VARIABLES
SET WRITE DECIMALS 2
CASE ASIS
TITLE CASE ASIS
LABEL CASE ASIS
TIC LABEL CASE ASIS
CHARACTER CASE ASIS ALL
LEGEND CASE ASIS
.
skip 25
read AUTO83B.DAT Y
.
multiplot corner coordiantes 2 2 98 98
multiplot 2 2
label size 6
x1label size 6
title size 6
tic mark label size 6
hw 5 3.0
.
title automatic
Histogram Y
y1label Correlation Coefficient
y1label displacement 18
Box-Cox Normality Plot Y
y1label
.
let temp = xplot
let atemp = maximum yplot
retain temp subset yplot = atemp
let lambda = temp(1)
justification center
move 50 2
font simplex
text max lc()LAMB() = ^lambda
font tektronix
.
let y2 = (y**lambda-1)/lambda
title Transformed Data
histogram y2
.
title Normal Proability Plot
character x
line blank
normal probability plot y2
.
end of multiplot
.
let string mark = AUTO83B.DAT
call mark5.dp
. box 0 0 100 100
.
device 2 close
system mv BOXCOX.PS boxcox.ps
.
quit
