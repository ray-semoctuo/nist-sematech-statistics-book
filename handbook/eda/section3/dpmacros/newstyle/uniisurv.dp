.
.  Generate sample output for Uniform Inverse Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na uniisurv.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Uniform Inverse Survival
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
X1LABEL Probability
Y1LABEL X
.
PLOT UNIPPF(1-P) FOR P = 0 0.1 1
.
box 0 0 100 100
.
device 2 close
system cp UNIISURV.PS uniisurv.ps
system rm UNIISURV.PS
.
quit
