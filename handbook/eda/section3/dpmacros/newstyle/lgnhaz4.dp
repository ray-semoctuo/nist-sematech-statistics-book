.
.  Generate sample output for Lognormal HAZ plot
.
device 1 x11
device 1 font simplex
set ipl1na lgnhaz4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Hazard
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Lognormal Hazard (sd = 0.5)
PLOT LGNHAZ(X,0.5) FOR X = 0.01 0.01 5
TITLE Lognormal Hazard (sd = 1)
PLOT LGNHAZ(X,1) FOR X = 0.0 0.01 5
TITLE Lognormal Hazard (sd = 2)
PLOT LGNHAZ(X,2) FOR X = 0.01 0.01 5
TITLE Lognormal Hazard (sd = 5)
PLOT LGNHAZ(X,5) FOR X = 0.01 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp LGNHAZ4.PS lgnhaz4.ps
system rm LGNHAZ4.PS
.
quit
