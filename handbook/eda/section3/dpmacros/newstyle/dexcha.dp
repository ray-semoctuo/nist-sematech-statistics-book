.
.  Generate sample output for Double Exponetial Cumulative Hazard plot
.
device 1 x11
device 1 font simplex
pre-erase off
erase
set ipl1na dexcha.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Double Exponential Cumulative Hazard
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Cumulative Hazard
X1LABEL X
.
PLOT -LOG(1-DEXCDF(X)) FOR X = -5 0.01 5
.
. box 0 0 100 100
.
device 2 close
system mv DEXCHA.PS dexcha.ps
.
quit
