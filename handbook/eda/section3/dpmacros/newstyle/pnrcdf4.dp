.
.  Generate sample output for Power Normal CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na pnrcdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Power Normal CDF (p = 0.5, sd = 1)
PLOT PNRCDF(X,0.5) FOR X = -5 0.01 5
TITLE Power Normal CDF (p = 1, sd = 1)
PLOT PNRCDF(X,1) FOR X = -5 0.01 5
TITLE Power Normal CDF (p = 5, sd = 1)
PLOT PNRCDF(X,5) FOR X = -5 0.01 5
TITLE Power Normal CDF (p = 10, sd = 1)
PLOT PNRCDF(X,10) FOR X = -5 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp PNRCDF4.PS pnrcdf4.ps
system rm PNRCDF4.PS
.
quit
