.
.  Generate sample output for Gamma CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na gamcdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Gamma CDF (0.5 df)
PLOT GAMCDF(X,0.5) FOR X = 0.01 0.01 10
TITLE Gamma CDF (1 df)
PLOT GAMCDF(X,1) FOR X = 0.01 0.01 10
TITLE Gamma CDF (2 df)
PLOT GAMCDF(X,2) FOR X = 0.01 0.01 10
TITLE Gamma CDF (5 df)
PLOT GAMCDF(X,5) FOR X = 0.01 0.01 10
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp GAMCDF4.PS gamcdf4.ps
system rm GAMCDF4.PS
.
quit
