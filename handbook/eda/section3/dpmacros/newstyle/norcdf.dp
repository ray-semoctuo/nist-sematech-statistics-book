.
.  Generate sample output for Normal CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na norcdf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Normal CDF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Probability
X1LABEL X
.
PLOT NORCDF(X) FOR X = -4 0.01 4
.
box 0 0 100 100
.
device 2 close
system cp NORCDF.PS norcdf.ps
system rm NORCDF.PS
.
quit
