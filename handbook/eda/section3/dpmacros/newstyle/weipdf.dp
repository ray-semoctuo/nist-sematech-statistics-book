.
.  Generate sample output for Weibull PDF plot
.
echo on
device 1 x11
device 1 font simplex
set ipl1na weipdf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Weibull PDF (Gamma = 1.5)
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
SET MINMAX MIN
PLOT WEIPDF(X,1.5) FOR X = 0.01 0.01 4
.
box 0 0 100 100
.
device 2 close
system cp WEIPDF.PS weipdf.ps
system rm WEIPDF.PS
.
quit
