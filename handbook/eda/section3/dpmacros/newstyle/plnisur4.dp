.
.  Generate sample output for Power Lognormal Inverse Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na plnisur4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Power Lognormal Inverse Survival (p = 0.5, sd = 1)
PLOT PLNPPF(1-P,0.5,1) FOR P = 0.01 0.01 0.99
TITLE Power Lognormal Inverse Survival (p = 1, sd = 1)
PLOT PLNPPF(1-P,1,1) FOR P = 0.01 0.01 0.99
TITLE Power Lognormal Inverse Survival (p = 0.99, sd = 1)
PLOT PLNPPF(1-P,5,1) FOR P = 0.01 0.01 0.99
TITLE Power Lognormal Inverse Survival (p = 10, sd = 1)
PLOT PLNPPF(1-P,10,1) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp PLNISUR4.PS plnisur4.ps
system rm PLNISUR4.PS
.
quit
