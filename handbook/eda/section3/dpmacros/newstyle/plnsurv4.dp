.
.  Generate sample output for Power Lognormal Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na plnsurv4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 5
TIC LABEL SIZE 5
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Power Lognormal Survival (p = 0.5, sd = 1)
PLOT 1 - PLNCDF(X,0.5) FOR X = 0.01 0.01 5
TITLE Power Lognormal Survival (p = 1, sd = 1)
PLOT 1 - PLNCDF(X,1) FOR X = 0.01 0.01 5
TITLE Power Lognormal Survival (p = 5, sd = 1)
PLOT 1 - PLNCDF(X,5) FOR X = 0.01 0.01 5
TITLE Power Lognormal Survival (p = 10, sd = 1)
PLOT 1 - PLNCDF(X,10) FOR X = 0.01 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system cp PLNSURV4.PS plnsurv4.ps
system rm PLNSURV4.PS
.
quit
