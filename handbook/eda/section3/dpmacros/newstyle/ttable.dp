.
.  Macro to generate t PPF Table.  List to 3
.  digits.
.
cd f:\handbook\eda\section3\dpmacros
let alpha = data 0.10 0.05 0.025 0.01 0.001
let alpha = 1 - alpha
set write rewind off
set write format f4.0,5x,5(f7.3,1x)
.
feedback off
loop for k = 1 1 100
   let ytemp = tppf(alpha,k)
   let b1 = ytemp(1)
   let b2 = ytemp(2)
   let b3 = ytemp(3)
   let b4 = ytemp(4)
   let b5 = ytemp(5)
   write tppf.out k b1 b2 b3 b4 b5
end of loop
.
let ytemp =norppf(alpha)
let b1 = ytemp(1)
let b2 = ytemp(2)
let b3 = ytemp(3)
let b4 = ytemp(4)
let b5 = ytemp(5)
write tppf.out k b1 b2 b3 b4 b5
quit
