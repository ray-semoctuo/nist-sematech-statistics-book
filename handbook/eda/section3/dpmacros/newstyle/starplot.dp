.
.  Generate sample output for star plot
.
device 1 x11
device 1 font simplex
set ipl1na starplot.ps
device 2 postscript
.
SKIP 25
COLUMN LIMITS 20 132
READ AUTO79.DAT Y1 TO Y9
LET N = SIZE Y1
LET CAR = SEQUENCE 1 1 N
.
LINES DOTTED ALL
LINES SOLID
LIMITS -1.5 1.5
.
. LOOP FOR K = 1 1 25
LOOP FOR K = 1 1 16
    LET NSKIP = 25 + K - 1
    COLUMN LIMITS 1 19
    SKIP NSKIP
    READ STRING AUTO79.DAT S^K
END OF LOOP
LABEL SIZE 12.0
MULTIPLOT 4 4
MULTIPLOT CORNER COORDINATES 2 2 98 95
. LOOP FOR K = 1 1 25
LOOP FOR K = 1 1 16
    X1LABEL ^S^K
    STAR PLOT Y1 Y2 Y3 Y4 Y5 Y6 Y7 Y8 Y9  SUBSET CAR K
END OF LOOP
END OF MULTIPLOT
MOVE 50 95
JUSTIFICATION CENTER
HEIGHT 3.5
TEXT 1979 Automobile Analysis
JUSTIFICATION LEFT
HEIGHT 3
MOVE 19 84
. TEXT Price
TEXT 1
MOVE 18.4 89
. TEXT Mileage
TEXT 2
MOVE 15 92
. TEXT 1978 Repair Record
TEXT 3
MOVE 10.5 91
. TEXT 1977 Repair Record
TEXT 4
MOVE 7 85.5
. TEXT Head Room
TEXT 5
MOVE 7 82
. TEXT Rear Seat Room
TEXT 6
MOVE 10 77.5
. TEXT Trunk Space
TEXT 7
MOVE 14.5 76
. TEXT Weight
TEXT 8
MOVE 19 80
. TEXT LENGTH
TEXT 9
.
box 0 0 100 100
.
device 2 close
system mv STARPLOT.PS starplot.ps
.
quit
