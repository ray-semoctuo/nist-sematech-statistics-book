.
.  Generate sample output for Normal PDF plot
.
device 1 x11
device 1 font simplex
set ipl1na norpdfs2.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Normal PDF (Scale = 1/3)
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Probability Density
X1LABEL X
.
PLOT NORPDF(X,0,0.333) FOR X = -2 0.01 2
.
box 0 0 100 100
.
device 2 close
system cp NORPDFS2.PS norpdfs2.ps
system rm NORPDFS2.PS
.
quit
