.
.  Generate sample output for chi-square CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na chscdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
Y1LABEL DISPLACEMENT 13
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Chi-Square CDF (1 df)
PLOT CHSCDF(X,1) FOR X = 0.01 0.01 10
TITLE Chi-Square CDF (2 df)
PLOT CHSCDF(X,2) FOR X = 0.01 0.01 10
TITLE Chi-Square CDF (5 df)
PLOT CHSCDF(X,5) FOR X = 0.01 0.01 10
TITLE Chi-Square CDF (10 df)
PLOT CHSCDF(X,10) FOR X = 0.01 0.01 10
.
END OF MULTIPLOT
.
box 0 0 100 100
.
device 2 close
system mv CHSCDF4.PS chscdf4.ps
.
. quit
