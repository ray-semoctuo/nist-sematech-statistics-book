.
.  Generate sample output for confidence limits
.
dimension 10000 rows
device 1 x11
device 1 font simplex
set ipl1na location.ps
device 2 postscript
thickness 0.2
x1label displacement 10
frame corner coordinates 15 25 95 95
.
let y1 = normal random numbers for i = 1 1 10000
let a1 = mean y1
let b1 = median y1
.
xlimits -10 10
.
let y2 = exponential random numbers for i = 1 1 10000
let a2 = mean y2
let b2 = median y2
let y3 = cauchy random numbers for i = 1 1 10000
let a3 = mean y3
let b3 = median y3
let y4 = lognormal random numbers for i = 1 1 10000
let a4 = mean y4
let b4 = median y4
multiplot corner coordiantes 2 2 98 98
multiplot 2 2
label size 7
title size 6
title displacement -8
tic mark label size 6
height 7
.
title normal random numbers
let a1 = round(a1,4)
let b1 = round(b1,4)
x1label mean = ^a1, median = ^b1
histogram y1
set write decimals 4
write normal.out xplot yplot
set write decimals 
.
. move 16 84
. text mean = ^a1
. move 16 78
. text median = ^b1
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c1 = junk(1)
let c1 = round(c1,4)
just center
move 50 1
text mode = ^c1
.
let a2 = round(a2,4)
let b2 = round(b2,4)
x1label mean = ^a2, median = ^b2
title exponential random numbers
histogram y2
set write decimals 4
write exponential.out xplot yplot
set write decimals
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c2 = junk(1)
let c2 = round(c2,4)
just center
move 50 1
text mode = ^c2
.
title cauchy random numbers
let a3 = round(a3,4)
let b3 = round(b3,4)
X1label mean = ^a3, median = ^b3
let atemp = standard deviation y4
histogram y3 subset y3 = -10 to 10
set write decimals 4
write cauchy.out xplot yplot
set write decimals
let amin = minimum y3
let amax = maximum y3
write cauchy2.out amin amax
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c3 = junk(1)
let c3 = round(c3,4)
just center
move 50 1
text mode = ^c3
.
.
tic offset units screen
ytic offset 0 5
title lognormal random numbers
let a4 = round(a4,4)
let b4 = round(b4,4)
x1label mean = ^a4, median = ^b4
histogram y4
write lognormal.out xplot yplot
let ajunk = maximum yplot
let junk = xplot
retain junk subset yplot = ajunk
let c4 = junk(1)
let c4 = round(c4,4)
just center
move 50 1
text mode = ^c4
.
end of multiplot
.
box 0 0 100 100
device 2 close
system mv LOCATION.PS location.ps
.
quit
