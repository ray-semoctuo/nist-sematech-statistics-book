. This is file    spect1.dp
. Create GIF files for a spectral plots
.
DEVICE 1 X11
device 1 font simplex
.
TITLE Spectral Plot
TITLE SIZE 4
TITLE DISPLACEMENT 2
LABEL CASE ASIS
Y1LABEL Spectral Power
X1LABEL Frequency (cycles per observation)
Y1LABEL DISPLACEMENT 10
LABEL SIZE 4
TIC LABEL SIZE 4
THICKNESS 0.2
TIC OFFSET UNITS SCREEN
XTIC OFFSET 2 2
.
LINE SOLID
CHARACTERS BLANK ALL
.
. -----CASE 0--TYPICAL SPECTRAL PLOT
.
ERASE
SET IPL1NA SPECT0.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ MAVRO.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = MAVRO.DAT
CALL MARK4.DP
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT0.PS spect0.ps
.
. -----CASE 1--RANDOM
.
echo on
SET IPL1NA SPECT1.PS
DEVICE 2 POSTSCRIPT
DELETE Y
LET Y = NORMAL RANDOM NUMBERS FOR I = 1 1 200
SPECTRAL PLOT Y
LET STRING MARK = RANDOM
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT1.PS spect1.ps
.
. -----CASE 2--MODERATE AUTOCORRELATION
.
ERASE
SET IPL1NA SPECT2.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ FLICKER.DAT Y
Y1LABEL DISPLACEMENT 12
SPECTRAL PLOT Y
Y1LABEL DISPLACEMENT 10
LET STRING MARK = FLICKER.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT2.PS spect2.ps
.
. -----CASE 3--STRONG AUTOCORRELATION
.
ERASE
SET IPL1NA SPECT3.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ RANDWALK.DAT Y
SPECTRAL PLOT Y
LET STRING MARK = RANDWALK.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT3.PS spect3.ps
.
. -----CASE 4--SINUSOIDAL MODEL
.
ERASE
SET IPL1NA SPECT4.PS
DEVICE 2 POSTSCRIPT
DELETE Y
SKIP 25
READ LEW.DAT Y
FRAME CORNER COORDINATES 20 20 90 90
Y1LABEL DISPLACEMENT 17
SPECTRAL PLOT Y
FRAME CORNER COORDINATES 15 20 85 90
Y1LABEL DISPLACEMENT 10
LET STRING MARK = LEW.DAT
MOVE 99 1
JUST RIGHT
HEIGHT 4
TEXT ^MARK
BOX 0 0 100 100
DEVICE 2 CLOSE
system mv SPECT4.PS spect4.ps
.
EXIT
