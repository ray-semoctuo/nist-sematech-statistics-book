.
.  Generate sample output for dex standard deviation plot
.
device 1 x11
device 1 font simplex
set ipl1na dexsdplo.ps
device 2 postscript
.
.
.  Jim's dplogf.tex settings
.
SET MINMAX MIN
CHARACTER MAPPING RANK
TIC OFFSET UNITS SCREEN
TIC OFFSET 5 5
TITLE DISPLACEMENT 2
DIMENSION 40 VARIABLES
SET WRITE DECIMALS 2
CASE ASIS
TITLE CASE ASIS
LABEL CASE ASIS
TIC LABEL CASE ASIS
CHARACTER CASE ASIS ALL
LEGEND CASE ASIS
THICKNESS 0.2
LABEL SIZE 4
TIC LABEL SIZE 4
TITLE SIZE 4
.
skip 25
read BOXBIKE2.DAT y x1 x2 x3 x4 x5 x6 x7
.
title DEX Standard Deviation Plot
y1label Standard Deviation
x1label Factors
.
dex standard deviation plot y x1 x2 x3 x4 x5 x6 x7
.
let string mark = BOXBIKE2.DAT
call mark5.dp
box 0 0 100 100
.
device 2 close
system cp DEXSDPLO.PS dexsdplo.ps
.
quit
