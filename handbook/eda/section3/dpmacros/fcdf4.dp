.
.  Generate sample output for F CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na fcdf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE OFFSET 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
Y1LABEL DISPLACEMENT 13
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE F CDF (1, 1 df)
PLOT FCDF(X,1,1) FOR X = 0 0.01 5
TITLE F CDF (1, 10 df)
PLOT FCDF(X,1,10) FOR X = 0 0.01 5
TITLE F CDF (10, 1 df)
PLOT FCDF(X,10,1) FOR X = 0 0.01 5
TITLE F CDF (10, 10 df)
PLOT FCDF(X,10,10) FOR X = 0 0.01 5
.
END OF MULTIPLOT
.
box 0 0 100 100
device 2 close
system mv FCDF4.PS fcdf4.ps
.
quit
