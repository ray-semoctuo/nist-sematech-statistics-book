.
.  Generate sample output for Exponential CDF plot
.
device 1 x11
device 1 font simplex
set ipl1na expcdf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Exponential CDF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
Y1LABEL Probability
X1LABEL X
.
PLOT EXPCDF(X) FOR X = 0.01 0.01 5
.
box 0 0 100 100
.
device 2 close
system cp EXPCDF.PS expcdf.ps
system rm EXPCDF.PS
.
quit
