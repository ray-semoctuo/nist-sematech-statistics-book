. THIS IS THE DATAPLOT PROGRAM FILE     BOXBIKE2.DP
. FACTORS AFFECTING BIKE SPEED
. BOX, HUNTER, & HUNTER, P. 390-397
. COMPLETE ANALYSIS OF 2**(7-4) DESIGN
. INPUT DATA FILE--BOXBIKE2.DAT
. OUTPUT FILES--DPPL1F.DAT (A POSTSCRIPT FILE CONTAINING ALL PLOT OUTPUT)
.               OUT1. (YATES ANALYSIS OUTPUT)
.               OUT2. (PREDICTED VALUES AND RESIDUALS FROM FINAL MODEL)
.               OUT3. (SORTED Y AND CARRY-ALONG X'S)
.
. -----START POINT----------
.
DIMENSION 40 VARIABLES
device 1 font simplex
.
height 6
legend size 6
title size 6
label size 6
tic label size 6
.
set ipl1na dexmeamp.ps
DEVICE 2 POSTSCRIPT
.
. STEP 1--READ IN THE DATA (N=8)
.
SKIP 25
READ BOXBIKE2.DAT Y X1 X2 X3 X4 X5 X6 X7
.
. STEP 2--GENERATE DEX SCATTER PLOT & DEX MEAN PLOT
.
MULTIPLOT CORNER COORDINATES 0 0 100 100
MULTIPLOT 2 2
LABEL SIZE 4
X3LABEL AUTOMATIC
CHAR X; LINES BLANK
DEX SCATTER PLOT Y X1 X2 X3 X4 X5 X6 X7
CHAR BLANK; LINES SOLID
. DEX MEAN PLOT Y X1 X2 X3 X4 X5 X6 X7
LINES SOLID ALL; LINES BLANK BLANK
MULTIPLOT OFF
device 2 close
system mv DEXMEAMP.PS dexmeamp.ps
.
. STEP 3--GENERATE MATRIX OF MEAN PLOTS (USE DEXSTAT2.DP MACRO)
.
set ipl1na dexinte.ps
DEVICE 2 POSTSCRIPT
X3LABEL
LET NUMFAC = 7
LET DP = 2
LET STRING STAT = MEAN
YLIMITS 50 90
LET STRING S0 = TIME (SEC)
LET STRING S1 = SEAT (X1)
LET STRING S2 = DYNAMO (X2)
LET STRING S3 = HANDLEBARS (X3)
LET STRING S4 = GEAR (X4)
LET STRING S5 = RAINCOAT (X5)
LET STRING S6 = BREAKFAST (X6)
LET STRING S7 = TIRES (X7)
CALL DEXSTAT2.DP
YLIMITS
device 2 close
system mv DEXINTE.PS dexinte.ps
.
