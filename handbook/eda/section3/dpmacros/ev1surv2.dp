.
.  Generate sample output for EV1 Survival plot
.
device 1 x11
device 1 font simplex
set ipl1na ev1surv2.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Extreme Value Type I (Maximum) PDF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
Y1LABEL Probability
X1LABEL X
.
SET MINMAX 2
PLOT 1 - EV1CDF(X) FOR X = -4 0.01 4
.
box 0 0 100 100
.
device 2 close
system cp EV1SURV2.PS ev1surv2.ps
system rm EV1SURV2.PS
.
quit
