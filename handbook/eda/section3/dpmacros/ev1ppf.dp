.
.  Generate sample output for EV1 PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na ev1ppf.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE Extreme Value Type I (Minimum) PPF
TITLE SIZE 3
LABEL SIZE 3
LABEL CASE ASIS
TIC LABEL SIZE 3
X1LABEL Probability
Y1LABEL X
.
SET MINMAX 1
PLOT EV1PPF(P) FOR P = 0.01 0.01 0.99
.
box 0 0 100 100
.
device 2 close
system cp EV1PPF.PS ev1ppf.ps
system rm EV1PPF.PS
.
quit
