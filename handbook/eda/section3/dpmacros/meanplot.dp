.
.  Generate sample output for confidence limits
.
device 1 x11
device 1 font simplex
set ipl1na meanplot.ps
device 2 postscript
.
SKIP 25
READ DRAFT69B.DAT Y JUNK X
RETAIN Y X SUBSET X > 0
.
TITLE AUTOMATIC
TITLE SIZE 3
LABEL CASE ASIS
X1LABEL Month
XLIMITS 1 12
XTIC OFFSET 0.5 0.5
MAJOR XTIC MARK NUMBER 12
MINOR XTIC MARK NUMBER 0
X1TIC MARK LABEL FORMAT ALPHA
X1TIC MARK LABEL CONTENT JAN FEB MARCH APRIL MAY JUNE JULY AUGUST ...
      SEPT OCT NOV DEC
Y1LABEL Mean Rank
LABEL SIZE 3
TIC LABEL SIZE 2.2
CHARACTER X BLANK
LINE BLANK SOLID
.
MEAN PLOT Y X
.
box 0 0 100 100
.
device 2 close
system cp MEANPLOT.PS meanplot.ps
.
quit
