.
.  Generate sample output for Poisson PPF plot
.
device 1 x11
device 1 font simplex
set ipl1na poippf4.ps
device 2 postscript
.
TITLE CASE ASIS
TITLE SIZE 6
TITLE DISPLACEMENT 3
LABEL SIZE 6
TIC LABEL SIZE 6
LABEL CASE ASIS
X1LABEL Probability
Y1LABEL X
Y1LABEL DISPLACEMENT 13
FRAME CORNER COORDINATES 20 20 90 90
THICKNESS 0.2
.
MULTIPLOT 2 2
MULTIPLOT CORNER COORDINATES 0 0 100 100
.
TITLE Poisson PPF (LAMBDA = 5)
PLOT POIPPF(P,5) FOR P = 0.01 0.01 0.99
TITLE Poisson PPF (LAMBDA = 15)
PLOT POIPPF(P,15) FOR P = 0.01 0.01 0.99
TITLE Poisson PPF (LAMBDA = 25)
PLOT POIPPF(P,25) FOR P = 0.01 0.01 0.99
TITLE Poisson PPF (LAMBDA = 35)
PLOT POIPPF(P,35) FOR P = 0.01 0.01 0.99
.
END OF MULTIPLOT
.
box 0 0 100 100
device 2 close
system mv POIPPF4.PS poippf4.ps
.
quit
