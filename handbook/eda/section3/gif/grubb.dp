device 1 x11
set ipl1na grubb.gif
device 2 gd gif
. device 2 font tektronix
. set gd font small
. set gd font Helvetica-Black-SemiBold.ttf
.
let y = data 199.31 199.53 200.19 200.82 201.92 201.95 202.18 245.57
.
font complex
label case asis
title case asis
title offset 5
title size 2
label size 2
.
y1label Data
x1label Theoretical
title Normal Probability Plot of Mass Spectrometer Measurements
line blank
char circle
char fill on
let h = 1.2
let w = h*0.75
char hw h w
.
normal probability plot y
device 2 close
.
set write decimals 4
capture GRUBBS.OUT
grubbs maximum y
end of capture
.
