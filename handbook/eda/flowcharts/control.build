#!/bin/csh -f
#
#dataplot < control.dp
#mv dppl1f.dat control.ps
gs -sDEVICE=ppm -sOutputFile=control.ppm  -dNOPAUSE -dBATCH control.ps
~/bin/pnmscale  -xscale 0.6 -yscale 0.6 control.ppm > control_s.ppm
~/bin/ppmtogif  control_s.ppm > control.gif
rm eq4.gif
~guthrie/software/giftrans -t \#ffffff -o eq4.gif control.gif
